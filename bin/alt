#!/usr/bin/env python3
"""alt — the Altitude CLI. Thin: state operations go through the library under a lock; serving is `alt serve`."""
from __future__ import annotations
import argparse
import json
import os
import sys
import uuid
from pathlib import Path

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
from altitude import config, l3, project_setup, state as S, tasks as T  # noqa: E402

ACTOR = os.environ.get("ALTITUDE_ACTOR", config.OPERATOR_ACTOR)
READ_COMMANDS = {("repo", None), ("pr", None), ("l3", "tools"), ("l3", "search"), ("audit", "status"), ("incident", "list"),
                 *(("task", name) for name in ("status", "show", "report", "events", "messages", "list"))}
L2_COMMANDS = READ_COMMANDS | {("task", "reply"), ("task", "block"), ("task", "resolve"), ("task", "done"),
                               ("task", "grant"), ("task", "run"), ("task", "validate"), ("task", "review"),
                               ("task", "terminal")}
L3_COMMANDS = READ_COMMANDS | {
    ("project", "set"), ("project", "setup"),
    ("pr", "close"),
    ("state", None), ("fyi", None), ("decisions", None), ("monitor", None), ("queue", None),
    ("issue", "new"), ("issue", "comment"), ("issue", "close"), ("issue", "inspect"),
    *(("task", name) for name in ("new", "reject", "escalate", "resume", "message", "stop", "paths", "hold-merge",
                                    "done", "preserve-checkout", "recheck-ci", "handoff", "grant", "release")),
    *(("incident", name) for name in ("new", "amend", "publish")),
}


class ExactArgumentParser(argparse.ArgumentParser):
    """The daemon validates exact CLI spellings; argparse must not silently invent aliases."""

    def __init__(self, *args, **kwargs):
        kwargs["allow_abbrev"] = False
        super().__init__(*args, **kwargs)


def _project(args) -> str:
    p = getattr(args, "project", None) or os.environ.get("ALTITUDE_PROJECT")
    if not p:
        sys.exit("alt: --project or ALTITUDE_PROJECT required")
    return p


def _question_input(args, reason: str | None) -> tuple[dict | None, str]:
    payload = None
    if args.questions_file:
        if any(value is not None for value in (args.recommendation, args.label, args.why)):
            sys.exit("questions JSON supplies its own options and recommendation")
        try:
            text = sys.stdin.read() if args.questions_file == "-" else Path(args.questions_file).read_text()
            payload = json.loads(text)
            items = T._validate_questions(payload)
        except (OSError, ValueError, T.TransitionError) as exc:
            sys.exit(f"invalid questions JSON: {exc}")
        reason = reason or "\n".join(item["question"] for item in items)
    if not reason or not reason.strip():
        sys.exit("supply a question/reason or --questions-file")
    return payload, reason.strip()


def _stdin_or_file(args) -> str:
    if getattr(args, "file", None):
        return sys.stdin.read() if args.file == "-" else Path(args.file).read_text()
    if getattr(args, "text", None) and args.text != "-":
        return args.text
    return sys.stdin.read()


def out(obj) -> None:
    print(json.dumps(obj, indent=2, sort_keys=True, default=str) if not isinstance(obj, str) else obj)


def _task_review(args, project: str) -> dict:
    from altitude import reviews
    slug = args.slug or os.environ.get("ALTITUDE_TASK")
    if not slug:
        sys.exit("alt task review: slug or ALTITUDE_TASK required")
    if ACTOR == "l2" and (project != os.environ.get("ALTITUDE_PROJECT")
                          or slug != os.environ.get("ALTITUDE_TASK")):
        sys.exit("alt task review: an L2 reviews only its own task and project")
    if args.review_action == "status":
        return reviews.view(project, slug)
    attempt = os.environ.get("ALTITUDE_ATTEMPT")
    if ACTOR == "l2" and not attempt:
        sys.exit("alt task review: ALTITUDE_ATTEMPT is required for the L2")
    options = {"actor": ACTOR, **({"expected_attempt": int(attempt)} if ACTOR == "l2" else {})}
    if args.review_action in ("run", "assess") and ACTOR != "l2":
        sys.exit("alt task review: only the current L2 runs or assesses a review")
    if args.review_action == "request":
        return reviews.request(project, slug, request_id=args.request_id or uuid.uuid4().hex,
                               focus=args.focus, source_id=args.source_message, previous=args.previous,
                               additional=args.additional, subject=args.subject, engine=args.engine, model=args.model, **options)
    if args.review_action == "assess":
        try:
            payload = json.loads(sys.stdin.read() if args.file == "-" else Path(args.file).read_text())
            if not isinstance(payload, dict) or set(payload) != {"dispositions", "reason"}:
                raise ValueError("expected an object with dispositions and reason")
        except (OSError, ValueError) as exc:
            sys.exit(f"alt task review: invalid assessment JSON: {exc}")
        return reviews.assess(project, slug, args.review_id, proposal_id=args.proposal_message, **payload, **options)
    action = reviews.cancel if args.review_action == "cancel" else reviews.withdraw
    return action(project, slug, args.review_id, reason=args.reason, **options)


def _one_line(value, limit: int = 240) -> str:
    text = value if isinstance(value, str) else json.dumps(value, sort_keys=True, default=str)
    text = " ".join(text.split())
    return text if len(text) <= limit else text[:limit - 1] + "…"


def _report_text(record: dict) -> str:
    prs = [f"#{p.get('number')} {'merged' if p.get('merged') else 'not merged'}"
           + (f" {str(p.get('merge_sha'))[:12]}" if p.get("merge_sha") else "") for p in record["prs"]]
    lines = [f"report {record['slug']}: {record.get('verdict') or 'unverified'} ({record.get('state') or '?'})",
             "PRs: " + (", ".join(prs) or "none"),
             "Blocked: " + (_one_line(record.get("blocked")) if record.get("blocked") else "none")]
    for key, label in (("decisions", "Decisions"), ("fyi", "FYI"), ("follow_ups", "Follow-ups"),
                       ("deviations", "Deviations")):
        lines.append(f"{label}: " + ("; ".join(_one_line(x) for x in record[key]) or "none"))
    spend = ", ".join(f"{k}={v}" for k, v in record["spend"].items()) or "none"
    lines.append(f"Spend: {spend}")
    if record.get("digest"):
        lines.append("Digest: " + _one_line(record["digest"]))
    if record["errors"]:
        lines.append("Errors: " + "; ".join(record["errors"]))
    return "\n".join(lines)


def _messages_text(rows: list[dict]) -> str:
    return "\n".join(f"[{S.age(str(row.get('at') or ''))}] {row.get('role') or '?'}"
                     f" ({row.get('by') or '?'}, message {row.get('id') or '?'}): "
                     f"{'[Removed before delivery] ' if row.get('removed_at') else ''}{_one_line(row.get('text') or '')}" for row in rows) or "No messages."


def _events_text(rows: list[dict]) -> str:
    lines = []
    for row in rows:
        kind = str(row.get("kind") or "event")
        if kind == "state":
            detail = f"{row.get('frm') or '?'} → {row.get('to') or '?'}"
        else:
            detail = next((str(row[key]) for key in ("reason", "hold", "note", "title") if row.get(key)), "")
        by = f" · {row['by']}" if row.get("by") else ""
        lines.append(f"[{S.age(str(row.get('at') or ''))}] {kind}" + (f": {_one_line(detail)}" if detail else "") + by)
    return "\n".join(lines) or "No events."


def _search_text(record: dict) -> str:
    lines = [record["notice"], f"{record['matched']} matching records; showing {len(record['results'])}. "
             f"Limit {record['limit']}; {record['excerpt_chars']} characters per excerpt; "
             f"{record['output_bytes']} bytes maximum output."]
    if record["status"] == "no_results":
        lines.append("No matching evidence found. No decision inferred.")
    if record["unavailable_task_count"]:
        lines.append(f"Partial search: {record['unavailable_task_count']} tasks lack a resolvable status record; "
                     f"showing {len(record['unavailable_tasks'])} unavailable sources. No decision inferred.")
        lines.extend(f"Unavailable task evidence: {source}" for source in record["unavailable_tasks"])
    if record["truncated"]:
        lines.append("Results omitted by output/result bounds; refine the query or increase --limit (maximum 20).")
    for result in record["results"]:
        lines.append(f"\nMatch: {result['match']}")
        for row in result["context"]:
            lines.append(f"[{row['at'] or 'date unknown'}; {row['date_kind']}] "
                         f"{row['role']} ({row['by'] or 'author not stored'}) {row['source']}")
            if row.get("removed_at"):
                lines.append("[Removed before delivery]")
            lines.append(row["text"])
            if row["truncated"]:
                lines.append(f"[excerpt characters {row['start']}:{row['end']} of {row['text_chars']}; truncated]")
    return "\n".join(lines)


def _brief_text(record: dict) -> str:
    from altitude import dispatch
    prs = ", ".join(f"#{p['number']} {str(p.get('state') or '?').lower()}" for p in record["prs"]) or "none"
    hold = record.get("hold_merge") or ((record.get("hold") or {}).get("reason")
                                         if isinstance(record.get("hold"), dict) else record.get("hold"))
    overlaps = []
    for other in record["other_leases"]:
        hits = dispatch.shared_paths(record["lease"], other["paths"])
        if hits:
            overlaps.append(f"{other['slug']} ({', '.join(hits)})")
    engine_name = record.get("l2_engine") or record.get("engine")
    model = record.get("engine_model") or record.get("model") or "default"
    engine = f"{engine_name}/{model}" if engine_name else "unassigned"
    ci = record.get("ci_recheck") or {}
    next_ci = ci.get("due_at") or (ci.get("delivery") or {}).get("next_at")
    waiting = f" ({record['waiting']})" if record.get("waiting") else ""
    return "\n".join([f"task {record['slug']}: {record.get('state') or '?'}{waiting}", f"engine/model: {engine}",
                      f"attempt: {record.get('attempt') or 0}", f"PRs: {prs}", f"hold: {hold or 'none'}",
                      f"blocked: {record.get('blocked_reason') or 'none'}", f"wip_hold: {record.get('wip_hold') or 'none'}",
                      f"operator grant: {(record.get('grant') or {}).get('purpose') or 'none'}",
                      "planned files: " + (", ".join(record["lease"]) or "none"),
                      "overlaps: " + ("; ".join(overlaps) or "none")]
                     + ([f"CI recheck: {ci['status']}; next action at {next_ci or 'none'}"] if ci else []))


def _queue_text(record: dict) -> str:
    lines = [f"Running ({len(record['running'])}):"]
    lines += [f"- {row['project']}/{row['slug']} ({row['age']})" for row in record["running"]] or ["- none"]
    lines.append(f"Waiting ({len(record['waiting'])}):")
    lines += [f"- {row['project']}/{row['slug']} [{row['state']}]: {_one_line(row['reason'])}"
              for row in record["waiting"]] or ["- none"]
    return "\n".join(lines)


def _repo_text(record: dict) -> str:
    checkout, restart, service = record["checkout"], record["restart_pending"], record["service"]
    drift = f"ahead {checkout.get('ahead', '?')}, behind {checkout.get('behind', '?')}"
    pending = (f"{len(restart.get('files') or [])} files ({', '.join((restart.get('files') or [])[:6])}) "
               f"since {restart.get('since') or '?'}"
               if restart else "none")
    faults = ", ".join(f"{kind}={row.get('count', 0)}" for kind, row in record["faults"].items()) or "none"
    unit = f"{service.get('state') or '?'}/{service.get('substate') or '?'} PID {service.get('pid') or '-'}"
    lines = [f"repo {record['project']}: {checkout.get('branch') or '?'} ({drift})",
             f"dirty files: {record.get('dirty_files') if record.get('dirty_files') is not None else '?'}",
             f"restart pending: {pending}", f"fault counters: {faults}",
             f"service: {unit}; last restart {service.get('last_restart') or '?'}"]
    if record["errors"]:
        lines.append("errors: " + "; ".join(record["errors"]))
    return "\n".join(lines)


def _pr_text(record: dict) -> str:
    checks = record["checks"]
    state = f"PR #{record['number']}: {record.get('state') or '?'}; merge {record.get('merge_sha') or '-'}"
    check_line = f"checks: {checks['passed']} passed, {checks['failed']} failed, {checks['pending']} pending"
    shown = record["files"][:8]
    suffix = f", … +{len(record['files']) - len(shown)} more" if len(record["files"]) > len(shown) else ""
    files = f"files ({len(record['files'])}): " + ((", ".join(shown) + suffix) if shown else "none")
    return "\n".join([state, check_line, files] + (["errors: " + "; ".join(record["errors"])] if record["errors"] else []))


def _tools_text(record: dict) -> str:
    ad_hoc = [group for group in record["groups"] if group["ad_hoc"]]
    known = [group for group in record["groups"] if not group["ad_hoc"]]
    lines = [f"L3 commands ({record['days']}d)", "Ad hoc:"]
    lines += [f"- {group['verb']}: {group['count']} · " + "; ".join(
        f"{row['count']}× {_one_line(row['command'], 160)}" for row in group["commands"][:2])
              for group in ad_hoc[:8]] or ["- none"]
    if len(ad_hoc) > 8:
        lines.append(f"- … +{len(ad_hoc) - 8} more ad-hoc groups")
    lines.append("Alt verbs:")
    lines += [f"- {group['verb']}: {group['count']}" for group in known[:12]] or ["- none"]
    if len(known) > 12:
        lines.append(f"- … +{len(known) - 12} more alt verbs")
    return "\n".join(lines)


def main(argv=None) -> None:
    ap = ExactArgumentParser(prog="alt")
    ap.add_argument("--project", "-p")
    sub = ap.add_subparsers(dest="cmd", required=True)
    audit_parser = sub.add_parser("audit", help="inspect or explicitly start/stop the finite conversation audit pilot")
    audit_commands = audit_parser.add_subparsers(dest="acmd", required=True)
    audit_commands.add_parser("status")
    audit_start = audit_commands.add_parser("start")
    audit_start.add_argument("--reason", required=True)
    audit_start.add_argument("--engine", choices=config.ENGINES)
    audit_start.add_argument("--model")
    audit_commands.add_parser("stop").add_argument("--reason", required=True)
    sp = sub.add_parser("project"); ps = sp.add_subparsers(dest="pcmd", required=True)
    a = ps.add_parser("add"); a.add_argument("name"); a.add_argument("--path"); a.add_argument("--approval", default="default")
    a.add_argument("--l2-engine", choices=config.ENGINES); a.add_argument("--l3-engine", choices=config.ENGINES)
    ps.add_parser("list"); ps.add_parser("discover")
    ps.add_parser("message", parents=[l3.project_message_parser()], help="coordinator socket: send information to a registered project")
    ps.add_parser("terminal", help="coordinator socket: read this project's terminal output (read-only)").add_argument(
        "--json", action="store_true", dest="as_json")
    ps.add_parser("setup", parents=[project_setup.parser()], help="inspect configuration; --repair requests supported daemon setup")
    r = ps.add_parser("remove"); r.add_argument("name")
    x = ps.add_parser("set"); x.add_argument("name"); x.add_argument("--reason", required=True)
    routing = x.add_mutually_exclusive_group(required=True)
    routing.add_argument("--routing", help="ordered engine[:model] tiers: comma ties, > lower priority")
    routing.add_argument("--unset-routing", action="store_true")
    routing.add_argument("--l2-preference", choices=config.ENGINES, help="engine fresh L2 routing tries first; the other stays its fallback")
    routing.add_argument("--unset-l2-preference", action="store_true", help="restore Auto: the routing tiers alone")
    for role, who in (("l2", "tasks"), ("l3", "L3")):
        routing.add_argument(f"--{role}-engine", choices=config.ENGINES, help=f"Only: keep this project's {who} on one engine, even over its choice")
        routing.add_argument(f"--unset-{role}-engine", action="store_true", help=f"let routing choose the engine for {who}")
    routing.add_argument("--l3-choice", metavar="CHOICE", help="L3's model choice, tried ahead of routing: [engine][:model][@effort], e.g. fable@high")
    routing.add_argument("--unset-l3-choice", action="store_true", help="back to Auto: L3 follows routing and defaults")
    for key, (role, engine, kind) in config.DEFAULT_SETTINGS.items():
        flag, where = key.replace("_", "-"), f"{role.upper()} on {config.ENGINE_LABELS[engine]}"
        if kind == "model":
            routing.add_argument(f"--{flag}", metavar="MODEL", help=f"default {where} model (alias or model id) for fresh launches routed there")
            routing.add_argument(f"--unset-{flag}", action="store_true", help="restore the role default model or the CLI's own configuration")
        else:
            routing.add_argument(f"--{flag}", choices=config.ENGINE_EFFORTS[engine], help=f"default {where} reasoning effort")
            routing.add_argument(f"--unset-{flag}", action="store_true", help="restore the existing engine default")
    m = sub.add_parser("machine"); ms = m.add_subparsers(dest="mcmd", required=True)
    ms.add_parser("show", help="inspect active/default concurrency limits and pending changes")
    x = ms.add_parser("set"); x.add_argument("--reason", required=True)
    one = x.add_mutually_exclusive_group(required=True)
    one.add_argument("--wip", type=int); one.add_argument("--unset-wip", action="store_true")
    one.add_argument("--voice", choices=("host", "browser"), help="host (live text from the speech model on this computer, after `alt voice setup`) or browser recognition")
    one.add_argument("--unset-voice", action="store_true", help="restore the default: host where the speech model can run, else browser")
    one.add_argument("--projects-folder", metavar="PATH", help="the folder whose immediate subfolders First run offers to add")
    one.add_argument("--unset-projects-folder", action="store_true", help="return to ALTITUDE_ROOTS, default ~/Projects")
    one.add_argument("--new-tasks", metavar="CHOICE", help="model choice for every project's new tasks, tried ahead of routing: [engine][:model][@effort]")
    one.add_argument("--unset-new-tasks", action="store_true", help="back to Auto: each project's routing and defaults")
    sub.add_parser("state")
    v = sub.add_parser("voice", help="host voice: the speech model on this computer")
    v.add_argument("vcmd", choices=("status", "setup", "remove"))
    t = sub.add_parser("task"); ts = t.add_subparsers(dest="tcmd", required=True)
    n = ts.add_parser("new"); n.add_argument("--title", required=True); n.add_argument("--hold-merge", metavar="WHY"); n.add_argument("--source", choices=("chat", "recovery"), default="chat"); n.add_argument("text", nargs="?", default="-"); n.add_argument("--file"); n.add_argument("--engine", choices=config.ENGINES, help="pin this L2; otherwise configured Auto tiers route it"); n.add_argument("--model", help="provider model override"); n.add_argument("--paths", help="comma-separated paths this task will touch")
    n.add_argument("--effort", choices=config.TASK_EFFORTS, help="override the project L2 effort defaults for this task")
    n.add_argument("--image", action="append", dest="image_ids", help="committed image ID from this project; repeat to attach")
    wait = n.add_mutually_exclusive_group()
    wait.add_argument("--wait", help="plan without dispatch until explicitly released; one short reason")
    wait.add_argument("--after", help="plan until one existing task in this project is archived done")
    release = ts.add_parser("release", help="L3/operator: clear a planned wait; ordinary dispatch gates still apply")
    release.add_argument("slug"); release.add_argument("--reason", required=True)
    for name in ("reject", "block"):
        x = ts.add_parser(name); x.add_argument("slug"); x.add_argument("--reason", required=name == "reject")
        if name == "block":
            x.add_argument("--questions-file", help="JSON with one to three questions; '-' reads stdin. Shape: "
                           '{"questions":[{"question":"...","options":[{"key":"a","label":"Short action","text":"Chosen approach"}],'
                           '"recommended_key":"a","why":"..."}]}; a plain question omits options and recommended_key; '
                           'add an existing "id" to revise that member')
            x.add_argument("--design-file", help="current L2: JSON selecting this question's screenshots and proposal text")
            x.add_argument("--recommendation"); x.add_argument("--label"); x.add_argument("--why")
            x.add_argument("--fault", action="store_true", help="the environment failed, not a decision: file the incident and tell L3")
            x.add_argument("--for-operator", action="store_true", help="the brief says to ask the operator here, or the call is plainly theirs: skip L3")
    es = ts.add_parser("escalate"); es.add_argument("slug"); es.add_argument("--question", help="one plain dilemma for the operator, with a recommendation")
    es.add_argument("--questions-file", help="JSON with one to three questions; L3 supplies '-' on stdin")
    es.add_argument("--recommendation"); es.add_argument("--label"); es.add_argument("--why")
    resolution = ts.add_parser("resolve", help="current L2: record a sourced decision or withdraw a doubtful question")
    resolution.add_argument("slug"); resolution.add_argument("--question", required=True)
    resolution.add_argument("--revision", type=int, help="default: the current revision"); resolution.add_argument("--message")
    resolution.add_argument("--source", choices=("task", "project"), default="task")
    resolution.add_argument("--disposition", choices=("answered", "superseded", "withdrawn"), required=True)
    resolution.add_argument("--reason", required=True); resolution.add_argument("--remaining")
    resolution.add_argument("--l3-authority", help="evidence and rationale that L3's answer settles an unnecessary escalation")
    resolution.add_argument("--recommendation"); resolution.add_argument("--label"); resolution.add_argument("--why")
    ts.add_parser("show", help="compatibility alias for task status --json").add_argument("slug")
    for name in ("events", "messages"):
        x = ts.add_parser(name); x.add_argument("slug"); x.add_argument("--last", type=int, default=10); x.add_argument("--json", action="store_true", dest="as_json")
    x = ts.add_parser("report"); x.add_argument("slug"); x.add_argument("--json", action="store_true", dest="as_json")
    x = ts.add_parser("terminal", help="current L2: read this task's terminal output (read-only)")
    x.add_argument("slug", nargs="?"); x.add_argument("--json", action="store_true", dest="as_json")
    x = ts.add_parser("status"); x.add_argument("slug", nargs="?"); x.add_argument("--brief", action="store_true"); x.add_argument("--json", action="store_true", dest="as_json")
    rs = ts.add_parser("resume", help="continue a blocked L2 or reported/open-PR owner; L3 can also return a contradicted report")
    rs.add_argument("slug"); rs.add_argument("--reason", required=True)
    ho = ts.add_parser("handoff", help="L3/operator: continue an exited, fault/limit-blocked owner as a fresh attempt on another configured engine")
    ho.add_argument("slug"); ho.add_argument("--engine", required=True, choices=config.ENGINES)
    ho.add_argument("--attempt", required=True, type=int); ho.add_argument("--reason", required=True)
    ms = ts.add_parser("message", help="message the existing L2; resumes blocked/open-PR owners or L3 correction of a contradicted report")
    ms.add_argument("slug"); ms.add_argument("text", nargs="?", default="-"); ms.add_argument("--file")
    ms.add_argument("--image", action="append", dest="image_ids", help="committed image ID from this project; repeat to attach")
    ms.add_argument("--summary", help="L3: one line (up to 100 characters) saying what the message is about")
    st = ts.add_parser("stop", help="ask altd to stop the task's L2 worker; the task blocks until resumed")
    st.add_argument("slug"); st.add_argument("--reason", required=True)
    pc = ts.add_parser("preserve-checkout", help="ask altd to archive dirty main for an unlaunched blocked task")
    pc.add_argument("slug"); pc.add_argument("--reason", required=True)
    ci = ts.add_parser("recheck-ci", help="L3/operator: record one bounded CI evidence probe for a blocked task")
    ci.add_argument("slug"); ci.add_argument("--run", required=True, type=int)
    ci.add_argument("--at", required=True); ci.add_argument("--reason", required=True)
    tp = ts.add_parser("paths", help="L3/operator: replace the advisory comma-separated planned file list")
    tp.add_argument("slug"); tp.add_argument("paths", metavar="a,b")
    hm = ts.add_parser("hold-merge", help="set a merge hold or apply operator approval")
    hm.add_argument("slug"); hm.add_argument("--why"); hm.add_argument("--off", action="store_true")
    hm.add_argument("--approval", help="L3 daemon: apply the named durable operator approval")
    hm.add_argument("--source", choices=("task", "project"), default="task")
    hm.add_argument("--question"); hm.add_argument("--revision", type=int)
    hm.add_argument("--pr-number", dest="pr", type=int); hm.add_argument("--head"); hm.add_argument("--reason")
    mc = ts.add_parser("grant", help="record the operator's grant for a task, or revoke it (owner, L3 or operator)")
    mc.add_argument("slug"); mc.add_argument("--revoke", action="store_true")
    mc.add_argument("--approval", help="the original operator approval message")
    mc.add_argument("--question"); mc.add_argument("--revision", type=int)
    mc.add_argument("--source", choices=("task", "project"), default="task"); mc.add_argument("--reason", required=True)
    mc.add_argument("--standing-policy", metavar="HEADING", help="L3: exact purpose from a single AGENTS.md paragraph on main")
    mc.add_argument("--from-task", metavar="SLUG", help="L3: the operator answered this question in another task of the project")
    mc.add_argument("--attempt", type=int, help="L3: observed current attempt, required with --standing-policy or --from-task")
    rn = ts.add_parser("run", help="current L2: run one command under the task's operator grant, outside the worker sandbox")
    rn.add_argument("slug"); rn.add_argument("command")
    vl = ts.add_parser("validate", help="current L2: run a command against its own committed candidate in a disposable, isolated validation run, no grant needed")
    vl.add_argument("--kvm", action="store_true", help="Linux: add /dev/kvm for a virtual machine")
    vl.add_argument("--publish", type=int, metavar="PORT", help="Linux: publish this container port on a free 127.0.0.1 port")
    vl.add_argument("--simulator", action="store_true", help="macOS: a disposable iOS Simulator iPhone whose Safari the command drives through $SIMULATOR_INSPECTOR")
    vl.add_argument("command", nargs=argparse.REMAINDER, help="-- then the command and its arguments")
    dn = ts.add_parser("done"); dn.add_argument("slug"); dn.add_argument("--digest", default=""); dn.add_argument("--file")
    dn.add_argument("--findings-tracked", default="", metavar="REFERENCE",
                    help="where coordination tracks the report's open review findings, e.g. '#461'")
    br = ts.add_parser("brief"); br.add_argument("slug"); br.add_argument("--file"); br.add_argument("text", nargs="?")
    rp = ts.add_parser("reply", help="current L2: append a human-readable reply to this task's conversation")
    rp.add_argument("text", nargs="*", metavar="[slug] text|-", help="optionally led by this task's slug, as in the sibling verbs; - or nothing reads stdin"); rp.add_argument("--file")
    review = ts.add_parser("review", help="request, run and assess a cross-engine review of the owned task")
    review_actions = review.add_subparsers(dest="review_action", required=True)
    for action in ("status", "request", "run", "assess", "cancel", "withdraw"):
        rv = review_actions.add_parser(action)
        rv.add_argument("slug", nargs="?", help="defaults to ALTITUDE_TASK")
        if action == "request":
            rv.add_argument("--subject", choices=("proposal", "changes"), help="defaults to changes, or the prior request's subject")
            rv.add_argument("--request-id", help="stable identity for retries of this request")
            rv.add_argument("--focus", default="")
            rv.add_argument("--source-message", help="original chat message requesting this review")
            rv.add_argument("--previous", help="review to retry, rerun, or replace while it waits to run")
            rv.add_argument("--additional", action="store_true",
                            help="another review of the subject that replaces none; current reviews and their open findings keep gating merge")
            rv.add_argument("--engine", choices=config.ENGINES, help="reviewer engine for this request only; never substituted")
            rv.add_argument("--model", help="reviewer model for this request only; never substituted")
        elif action != "status":
            rv.add_argument("--review-id", required=True)
            if action == "run":
                rv.add_argument("--proposal-message", help="exact original L2 proposal message to review")
                rv.add_argument("--context-message", action="append", help="original task context message; repeat as needed")
            elif action == "assess":
                rv.add_argument("--proposal-message", help="revised original L2 proposal message being assessed")
                rv.add_argument("--file", default="-", help="JSON with dispositions and reason; defaults to stdin")
            else:
                rv.add_argument("--reason", required=True)
    ls = ts.add_parser("list"); ls.add_argument("--all", action="store_true")

    f = sub.add_parser("fyi"); f.add_argument("slug", nargs="?"); f.add_argument("text")
    sub.add_parser("decisions"); sub.add_parser("monitor")
    q = sub.add_parser("queue"); q.add_argument("--json", action="store_true", dest="as_json")
    rr = sub.add_parser("repo"); rr.add_argument("--json", action="store_true", dest="as_json")
    pr = sub.add_parser("pr"); pr.add_argument("target", help="PR number to inspect, or close")
    pr.add_argument("number", type=int, nargs="?"); pr.add_argument("--json", action="store_true", dest="as_json")
    l3p = sub.add_parser("l3"); l3s = l3p.add_subparsers(dest="l3cmd", required=True)
    lt = l3s.add_parser("tools"); lt.add_argument("--days", type=int, default=7); lt.add_argument("--json", action="store_true", dest="as_json")
    ls = l3s.add_parser("search", help="find historical project conversation and task evidence")
    ls.add_argument("query"); ls.add_argument("--limit", type=int, default=5); ls.add_argument("--json", action="store_true", dest="as_json")
    from altitude import server
    sub.add_parser("issue", parents=[server.issue_parser()], add_help=False)
    dp = sub.add_parser("dispatch"); dp.add_argument("slug"); dp.add_argument("--model")
    vf = sub.add_parser("verify"); vf.add_argument("slug")
    pl = sub.add_parser("poll")
    ln = sub.add_parser("land"); ln.add_argument("--message", required=True, help="commit message; its first line is the default PR title"); ln.add_argument("--pr-title"); ln.add_argument("--pr-body-file"); ln.add_argument("--merge", action="store_true"); ln.add_argument("--approval", help="with --merge on a held task: the operator's task-chat message approving this PR"); ln.add_argument("--wait", type=int, default=600, help="shared seconds to wait for PR checks and owner review assessment (0 = do not wait)"); ln.add_argument("--base", default="main"); ln.add_argument("--test-cmd", default="make test", help="one command split into argv without a shell, run as the full local suite on the merge candidate only when neither pinned side has hosted CI: 'make check', or an explicit wrapper such as 'sh -c \"pnpm typecheck && pnpm test\"'"); ln.add_argument("--dry-run", action="store_true", help="report the prospective base, head or staged tree and gate; commit, push, open, test and merge nothing")
    ln.add_argument("--adopt-pr", type=int, help="adopt an existing same-repository PR, preserving its branch and history")
    ln.add_argument("--closes-issue", type=int, action="append", default=[], help="require a GitHub closing link for this fully resolved issue in the project repository (repeatable)")
    ln.add_argument("--expected-head", help="full observed PR head SHA required with --adopt-pr")
    ln.add_argument("--reason", help="why this task is authorized to adopt the PR; required with --adopt-pr")
    ch = sub.add_parser("chat"); ch.add_argument("text", nargs="?", default="-"); ch.add_argument("--trigger", default="chat"); ch.add_argument("--engine", choices=config.ENGINES, help="pin this turn to one engine")
    sub.add_parser("l3-reset")
    ic = sub.add_parser("incident"); ics = ic.add_subparsers(dest="icmd", required=True)
    inew = ics.add_parser("new"); inew.add_argument("--title", required=True); inew.add_argument("--task"); inew.add_argument("--what", required=True); inew.add_argument("--evidence", required=True); inew.add_argument("--cause", required=True); inew.add_argument("--tag", action="append", default=[])
    iam = ics.add_parser("amend"); iam.add_argument("id"); iam.add_argument("--what"); iam.add_argument("--evidence"); iam.add_argument("--cause"); iam.add_argument("--status", choices=["open", "watch", "closed"]); iam.add_argument("--issue", help="attach the existing GitHub issue that tracks this cause"); iam.add_argument("--reason", required=True)
    ipub = ics.add_parser("publish", help="create the incident's GitHub issue after a failed publication"); ipub.add_argument("id")
    ics.add_parser("list")
    sv = sub.add_parser("serve"); sv.add_argument("--host"); sv.add_argument("--port", type=int)
    sub.add_parser("install-git-guards")
    sub.add_parser("doctor", help="inspect application prerequisites without provider requests")
    sub.add_parser("recover", help="restore the previous installation after interrupted activation")
    sub.add_parser("uninstall", help="remove the owned application service and retain user data")
    installer = sub.add_parser("install", help="install an exact verified private application archive")
    installer.add_argument("--archive", type=Path, required=True)
    installer.add_argument("--sha256", required=True)
    installer.add_argument("--prefix", type=Path)
    updater = sub.add_parser("update", help="update to the latest published release, a named version or an exact archive")
    updater.add_argument("--version", help="a published release version, for example v0.1.1")
    updater.add_argument("--archive", type=Path, help="an exact archive file instead of downloading; needs --sha256")
    updater.add_argument("--sha256")
    service = sub.add_parser("service", help="manage the installed application user service")
    service.add_argument("operation", choices=("start", "stop", "status", "logs", "prepare-tls"))
    service.add_argument("--directory", type=Path, help="existing source deployment certificate directory")
    service.add_argument("--apply", action="store_true", help="apply the verified source TLS service override")
    ti = sub.add_parser("tls-init"); ti.add_argument("--ip")
    sub.add_parser("tls-share", help="offer the HTTPS certificate to a phone on this network for ten minutes")
    sub.add_parser("pair", help="print a one-time code that pairs one browser with Altitude")

    args = ap.parse_args(argv)
    if "ALTITUDE_ACTOR" not in os.environ and config.RELEASE is not None and args.cmd != "update" and sys.stderr.isatty():
        from altitude import installation
        if notice := installation.update_notice():
            print(notice, file=sys.stderr)
    if args.cmd not in ("install", "update", "recover", "uninstall", "doctor", "service"):
        config.ensure_root()
    c = args.cmd
    if c == "project" and args.pcmd in ("message", "terminal"):
        sys.exit(f"alt project {args.pcmd} is available only through the project's coordinator socket")
    closing_pr = c == "pr" and args.target == "close"
    actor_command = (c, getattr(args, "tcmd", None) if c == "task" else
                     getattr(args, "acmd", None) if c == "audit" else
                     getattr(args, "icmd", None) if c == "incident" else
                     getattr(args, "pcmd", None) if c == "project" else
                     getattr(args, "l3cmd", None) if c == "l3" else None)
    setup_command = c == "project" and args.pcmd == "setup"
    if c == "issue" or closing_pr:
        actor_command = (c, "close" if closing_pr else args.operation)
    if ACTOR == "l2":
        if actor_command not in L2_COMMANDS and c not in ("land", "fyi", "incident"):
            sys.exit(f"alt {c}: not available to an L2 worker; use project inspection or owned-task verbs")
        if c in ("repo", "pr", "l3", "audit") and _project(args) != os.environ.get("ALTITUDE_PROJECT"):
            sys.exit("alt: owner inspection is bound to the launch project")
    if ACTOR == "l3" and actor_command not in L3_COMMANDS:
        sys.exit(f"alt {c}: not available to an L3 coordinator; use the documented inspection and task-coordination verbs")
    if closing_pr and (args.number is None or args.number < 1 or args.as_json):
        ap.error("alt pr close requires one positive PR number and no options")
    machine_run = c == "task" and args.tcmd == "run"
    validation_run = c == "task" and args.tcmd == "validate"
    if validation_run:
        args.slug = os.environ.get("ALTITUDE_TASK")
        args.command = args.command[1:] if args.command[:1] == ["--"] else args.command
        if ACTOR != "l2" or not args.slug or not os.environ.get("ALTITUDE_ATTEMPT"):
            sys.exit("alt task validate: only the current L2 runs validation, and only for its own task")
        if not args.command:
            ap.error("alt task validate: give the command after --")
    terminal_read = c == "task" and args.tcmd == "terminal"
    if terminal_read:
        args.slug = args.slug or os.environ.get("ALTITUDE_TASK")
        if ACTOR != "l2" or args.slug != os.environ.get("ALTITUDE_TASK") or not os.environ.get("ALTITUDE_ATTEMPT"):
            sys.exit("alt task terminal: only the current L2 reads its own task's terminal")
    review_run = c == "task" and args.tcmd == "review" and args.review_action == "run"
    if review_run:
        args.slug = args.slug or os.environ.get("ALTITUDE_TASK")
        if (ACTOR != "l2" or args.slug != os.environ.get("ALTITUDE_TASK")
                or _project(args) != os.environ.get("ALTITUDE_PROJECT") or not os.environ.get("ALTITUDE_ATTEMPT")):
            sys.exit("alt task review run: only the current L2 runs reviews for its own task and project")
    if machine_run and (ACTOR != "l2" or args.slug != os.environ.get("ALTITUDE_TASK") or not os.environ.get("ALTITUDE_ATTEMPT")):
        sys.exit("alt task run: only the current L2 runs commands, and only for its own task")
    if c == "issue" or closing_pr or setup_command or machine_run or validation_run or review_run or terminal_read:
        import ssl
        import urllib.error
        import urllib.request
        body = "" if setup_command or machine_run or validation_run or review_run or terminal_read or sys.stdin.isatty() and (closing_pr or args.operation == "close") else sys.stdin.read()
        payload = {"project": _project(args), "slug": args.slug, "attempt": os.environ["ALTITUDE_ATTEMPT"],
                   "review_id": args.review_id, "context_ids": args.context_message, "proposal_id": args.proposal_message} if review_run else {"project": _project(args), "slug": args.slug, "attempt": os.environ["ALTITUDE_ATTEMPT"]} if terminal_read else {"project": _project(args), "slug": args.slug, "attempt": os.environ["ALTITUDE_ATTEMPT"], "command": args.command, "request": uuid.uuid4().hex} if machine_run else {"project": _project(args), "slug": args.slug, "attempt": os.environ["ALTITUDE_ATTEMPT"], "command": args.command, "kvm": args.kvm, "publish": args.publish, "simulator": args.simulator} if validation_run else {"project": args.name, "action": "repair", "reason": args.reason} if setup_command else {"project": _project(args), "number": args.number, "body": body} if closing_pr else {
                   "project": _project(args), "operation": args.operation, "body": body,
                   **{key: getattr(args, key) for key in ("title", "labels", "number", "reason") if hasattr(args, key)}}
        # An option left unset sends nothing, so a checkout awaiting activation keeps working against the older
        # running service, whose handlers refuse fields they do not know; each handler reads absence as that default.
        payload = {key: value for key, value in payload.items() if value is not None and value is not False}
        # L3 uses its runtime shim/socket; HTTP is the operator's existing daemon surface.
        if ACTOR == "l3":
            sys.exit(f"alt {c}: L3 must use its project-bound runtime alt socket")
        if setup_command and (bool(args.repair) != bool(args.reason and args.reason.strip())):
            ap.error("project setup --repair requires --reason; reads accept no reason")
        from altitude import access, tls, validation
        from urllib.parse import quote
        endpoint = "task/review/run" if review_run else "task/terminal" if terminal_read else "task/run" if machine_run else "task/validate" if validation_run else ("project/setup" if args.repair else "setup/" + quote(args.name, safe="")) if setup_command else "pr/close" if closing_pr else "issue"
        import http.client
        import time
        # A restart can end a machine command's connection while its unit runs on; asking again with the same
        # request waits for that command's result instead of running it again.
        reconnect_until, reconnecting = time.monotonic() + config.MACHINE_COMMAND_TIMEOUT + 120, False
        while True:
            # The running service's record, not this process's launch environment, says where altd listens and
            # which CA proves it, read afresh for each attempt, so a restart onto another certificate folder or
            # port strands neither a running worker nor a command waiting across that restart.
            try:
                found = tls.service()
            except tls.TLSFailure as exc:
                sys.exit(f"alt {c}: altd unavailable: {exc}")
            ca = found["tls_dir"] / "ca.crt"
            from altitude import platform
            service_url = f"https://localhost:{found['port']}" if platform.containerized() else found["url"]
            request = urllib.request.Request(f"{service_url}/api/{endpoint}",
                                             data=None if setup_command and not args.repair else json.dumps(payload).encode(),
                                             headers={"Content-Type": "application/json", access.KEY_HEADER: access.machine_key() or ""})
            context = ssl.create_default_context(cafile=str(ca) if ca.exists() else None) if found["tls"] else None
            try:
                with urllib.request.urlopen(request, context=context, timeout=None if review_run else config.MACHINE_COMMAND_TIMEOUT + 60 if machine_run else validation.TIMEOUT + 600 + (validation.SIMULATOR_SECONDS if args.simulator else 0) if validation_run else 130) as response:
                    result = json.load(response)
                    if review_run and not result.get("ok"):
                        sys.exit(result.get("error", "Review execution failed"))
                    if terminal_read:
                        from altitude import terminal
                        out(result) if args.as_json else print(terminal.describe(result, "task"))
                        return
                    if machine_run or validation_run:
                        sys.stdout.write(result["output"])
                        ended = result.get("ended", "exit")
                        print(f"[altitude] {result['unit']}: exit {result['exit']}"
                              + (f"; {ended}" if ended != "exit" else "")
                              + (f"; {result['error']}" if result.get("error") else "")
                              + (f"; {result['cleanup']}" if result.get("cleanup") else "")
                              + ("; output truncated, read the log" if result.get("output_truncated") else "")
                              + f"; log {result['log']}"
                              + (f"; results {result['results']}; commit {result['commit']} tree {result['tree']}; "
                                 f"{result['host']}; {result['isolation']}" if validation_run else "")
                              + ("; " + ", ".join(str(result["simulator"].get(key)) for key in (
                                  "device", "runtime", "safari", "xcode", "screenshot") if result["simulator"].get(key))
                                 if validation_run and result.get("simulator") else ""))
                        # Only a command that exited 0 and whose run ended cleanly is a success.
                        code = 124 if result["timed_out"] else result["exit"] if ended == "exit" else 1
                        sys.exit(1 if code is None else code)
                    out(result["review"] if review_run else result if closing_pr or setup_command else result["url"])
            except urllib.error.HTTPError as exc:
                if exc.code == 401:
                    sys.exit(f"alt {c}: altd refused this machine's key; read access to {access.DIR / 'machine.key'} is required")
                sys.exit(("" if machine_run or validation_run else f"alt {c}: ") + json.load(exc).get("error", str(exc)))
            except (OSError, http.client.HTTPException, ValueError) as exc:
                # urllib reports a failure to connect or send as URLError: altd never received that request.
                if machine_run and (reconnecting or not isinstance(exc, urllib.error.URLError)) \
                        and time.monotonic() < reconnect_until:
                    if not reconnecting:
                        print(f"[altitude] the connection to altd ended ({exc}); waiting for this command's result",
                              file=sys.stderr)
                    reconnecting = True
                    time.sleep(2)
                    continue
                if isinstance(getattr(exc, "reason", None), ssl.SSLCertVerificationError):
                    sys.exit(f"alt {c}: altd at {found['url']} does not prove its identity with "
                             f"{ca if ca.exists() else 'the system trust store'}: {exc.reason.verify_message}")
                sys.exit(f"alt {c}: altd unavailable: {exc}")
            break
        return
    if c in ("install", "update", "recover", "uninstall", "doctor", "service"):
        from altitude import installation
        try:
            if c == "install":
                result = installation.install(args.archive, args.sha256, args.prefix)
            elif c == "update":
                if (args.archive is None) != (args.sha256 is None) or (args.archive and args.version):
                    ap.error("update takes --archive with --sha256, or --version, or neither for the latest release")
                result = (installation.install(args.archive, args.sha256, installation._prefix()) if args.archive
                          else installation.update(args.version))
            elif c == "service":
                if args.operation == "prepare-tls":
                    if args.directory is None:
                        ap.error("service prepare-tls requires --directory")
                    from altitude import source_tls
                    result = source_tls.prepare(args.directory, apply=args.apply)
                else:
                    if args.directory is not None or args.apply:
                        ap.error("--directory and --apply require service prepare-tls")
                    result = installation.service(args.operation)
            else:
                result = getattr(installation, c)()
            out(result)
        except (ValueError, RuntimeError, OSError) as exc:
            sys.exit(f"alt {c}: {exc}")
        return
    if c == "audit":
        from altitude import audit
        if args.acmd == "status":
            out(audit.status(_project(args)))
        else:
            out(audit.configure(_project(args), args.acmd, actor=ACTOR, reason=args.reason,
                                engine=getattr(args, "engine", None), model=getattr(args, "model", None)))
        return
    if c == "machine":
        from altitude import dispatch
        if args.mcmd == "set":
            if args.voice is not None or args.unset_voice:
                out(dispatch.request_setting(None, "voice", None if args.unset_voice else args.voice, args.reason, actor=ACTOR))
            elif args.new_tasks is not None or args.unset_new_tasks:
                out(dispatch.request_setting(None, "new_tasks", None if args.unset_new_tasks else args.new_tasks, args.reason, actor=ACTOR))
            elif args.projects_folder is not None or args.unset_projects_folder:
                value = None if args.unset_projects_folder else str(Path(args.projects_folder).expanduser().absolute())
                out(dispatch.request_setting(None, "projects_folder", value, args.reason, actor=ACTOR))
            else:
                out(dispatch.request_setting(None, "wip", args.wip, args.reason, actor=ACTOR))
        else:
            # A receipt from before the speech-service removal can name a service key until altd next starts.
            voice_request = S.read_json(config.ROOT / "voice-request.json", None)
            if isinstance(voice_request, dict):
                voice_request = {k: "removed speech service" if isinstance(v, dict) else v for k, v in voice_request.items()}
            out({"wip": config.machine_wip(), "override": config.machine_settings().get("wip"),
                 "default": config.WIP_PER_MACHINE,
                 "request": S.read_json(config.ROOT / "wip-request.json", None),
                 "voice": config.voice_setting(),
                 "voice_request": voice_request,
                 "projects_folder": [str(root) for root in config.project_roots()],
                 "new_tasks": config.machine_settings().get("new_tasks"),
                 "new_tasks_request": S.read_json(config.ROOT / "new_tasks-request.json", None),
                 "projects_folder_request": S.read_json(config.ROOT / "projects_folder-request.json", None)})
        return
    if c == "project":
        if args.pcmd == "set":
            from altitude import dispatch
            if ACTOR == "l3" and args.name != _project(args):
                sys.exit("alt project set: the L3 socket fixes the project")
            setting = next(key for key in config.PROJECT_SETTINGS
                           if getattr(args, key) is not None or getattr(args, f"unset_{key}"))
            out(dispatch.request_setting(args.name, setting, getattr(args, setting), args.reason, actor=ACTOR))
            return
        if args.pcmd == "discover":
            out(config.discover_projects())
            return
        if args.pcmd == "add":
            try:
                with config.add_project(args.name, path=args.path, approval=args.approval,
                                        l2_engine=args.l2_engine, l3_engine=args.l3_engine) as entry:
                    out(entry)
                S.regen_state_md(args.name)
                project_setup.registered(args.name)
            except ValueError as exc:
                sys.exit(f"alt: {exc}")
        elif args.pcmd == "remove":
            config.remove_project(args.name); out("removed")
        else:
            out(config.load_projects())
        return
    if c == "state":
        print(S.regen_state_md(_project(args))); return
    if c == "task":
        p = _project(args); tc = args.tcmd
        if tc == "new":
            out(T.new(p, args.title, _stdin_or_file(args), actor=ACTOR, source=args.source, model=args.model, engine=args.engine, effort=args.effort, paths=(args.paths or "").split(",") if args.paths else None, hold_merge=args.hold_merge, image_ids=args.image_ids, wait=args.wait, after=args.after))
        elif tc == "release":
            out(T.release(p, args.slug, args.reason, actor=ACTOR))
        elif tc in ("reject", "resume", "stop", "preserve-checkout", "handoff"):
            from altitude import dispatch
            options = {"engine": args.engine, "expected_attempt": args.attempt} if tc == "handoff" else {}
            out(dispatch.request_task_operation(p, args.slug, tc, args.reason, actor=ACTOR, **options))
        elif tc == "recheck-ci":
            out(T.recheck_ci(p, args.slug, args.run, args.at, args.reason, actor=ACTOR))
        elif tc == "block":
            questions, args.reason = _question_input(args, args.reason)
            design = None
            if args.design_file:
                if (ACTOR != "l2" or args.slug != os.environ.get("ALTITUDE_TASK")
                        or p != os.environ.get("ALTITUDE_PROJECT") or not os.environ.get("ALTITUDE_ATTEMPT")
                        or args.fault or (questions is not None and len(questions["questions"]) != 1)):
                    sys.exit("alt task block --design-file: only the current L2's own project/task and one question")
                try:
                    with open(args.design_file, "rb") as stream:
                        data = stream.read(T.DESIGN_TEXT_LIMIT + 1)
                    if len(data) > T.DESIGN_TEXT_LIMIT:
                        raise ValueError("design selection exceeds 64 KiB")
                    design = json.loads(data)
                except (OSError, ValueError) as exc:
                    sys.exit(f"alt task block --design-file: {exc}")
            if args.fault and questions is not None:
                sys.exit("alt task block: --fault needs --reason, not questions JSON")
            if ACTOR == "l2":
                attempt = os.environ.get("ALTITUDE_ATTEMPT")
                if args.slug != os.environ.get("ALTITUDE_TASK") or not attempt:
                    sys.exit("alt task block: an L2 blocks only its own task (ALTITUDE_TASK, ALTITUDE_ATTEMPT)")
                if args.fault:
                    if S.load_task(p, args.slug).get("attempt") != int(attempt):
                        sys.exit(f"alt task block: attempt {attempt} is no longer current")
                else:
                    waiting = T.OPERATOR_MESSAGE_ROLE if args.for_operator else "l3"
                    previous_questions = {(q["id"], q["revision"])
                                          for q in S.load_task(p, args.slug).get("questions", [])}
                    if note := T.observe_held_pr(p, args.slug, by="l2"):
                        print(f"alt task block: {note}; the held review card keeps the recorded delivery",
                              file=sys.stderr)
                    blocked = T.block(p, args.slug, args.reason, actor="l2", expected_state="running",
                                      expected_attempt=int(attempt), updates={"waiting_on": waiting},
                                      recommendation=args.recommendation, recommendation_label=args.label,
                                      recommendation_why=args.why, questions=questions, design=design)
                    if design is not None:
                        design_question = questions["questions"][0]["question"] if questions else args.reason
                        question = next(q for q in reversed(blocked["questions"])
                                        if q["status"] == "open" and q["detail"].strip() == design_question.strip())
                        out({**blocked, "design_url": T.design_url(p, args.slug, question)})
                    else:
                        out(blocked)
                    if any(q["status"] == "open" and (q["id"], q["revision"]) not in previous_questions
                           for q in blocked.get("questions", [])):
                        l3.queue_message(p, T.block_question(blocked), trigger="block", slug=args.slug)
            elif not args.fault:
                out(T.block(p, args.slug, args.reason, actor=ACTOR, updates={"waiting_on": T.OPERATOR_MESSAGE_ROLE},
                            questions=questions, recommendation=args.recommendation,
                            recommendation_label=args.label, recommendation_why=args.why))
            if args.fault:
                # An environment fault is Altitude's to fix, not a question for the operator: the same path as a fault
                # altd detects itself (block, one incident per kind per day, one message for L3).
                from altitude import incidents
                out(incidents.system_fault(f"worker:{args.slug}", args.reason, project=p, task=args.slug)
                    or {"state": "blocked", "note": "this fault was already filed today; L3 was told once"})
        elif tc == "escalate":
            questions, args.question = _question_input(args, args.question)
            out(T.escalate(p, args.slug, args.question, actor=ACTOR, recommendation=args.recommendation,
                          recommendation_label=args.label, recommendation_why=args.why, questions=questions))
        elif tc == "resolve":
            attempt = os.environ.get("ALTITUDE_ATTEMPT")
            if (ACTOR != "l2" or args.slug != os.environ.get("ALTITUDE_TASK")
                    or p != os.environ.get("ALTITUDE_PROJECT") or not attempt):
                sys.exit("alt task resolve: only the current L2 may resolve its own task question")
            out(T.resolve_question(p, args.slug, args.question, args.revision, args.message,
                                   expected_attempt=int(attempt), source=args.source, disposition=args.disposition,
                                   reason=args.reason, remaining=args.remaining, recommendation=args.recommendation,
                                   recommendation_label=args.label, recommendation_why=args.why,
                                   l3_authority=args.l3_authority))
        elif tc == "message":
            if ACTOR == "l3" and not (args.summary or "").strip():
                sys.exit("alt task message: L3 adds --summary '<one line saying what the message is about>'")
            message = T.message(p, args.slug, "l3" if ACTOR == "l3" else T.OPERATOR_MESSAGE_ROLE, _stdin_or_file(args), by=ACTOR, image_ids=args.image_ids, summary=args.summary)
            out(message)
        elif tc == "paths":
            declared = [x.strip() for x in args.paths.split(",") if x.strip()]
            if not declared:
                sys.exit("alt task paths: no paths named")
            with S.project_lock(p):
                task = S.load_task(p, args.slug)
                previous = task.get("paths") or []
                task["paths"] = declared
                S.save_task(p, task)
                S.append_event(p, args.slug, "paths", by=ACTOR, previous=previous, paths=declared)
            S.regen_state_md(p)
            out(task)
        elif tc == "hold-merge":
            if args.approval or args.pr is not None or args.head or args.reason:
                sys.exit("alt task hold-merge --approval: use the project-bound L3 daemon socket")
            if not args.off and not args.why:
                sys.exit("alt task hold-merge: --why <reason> (or --off)")
            if args.off and ACTOR != config.OPERATOR_ACTOR:
                sys.exit("alt task hold-merge: only the operator may release a merge hold")
            out(T.set_hold_merge(p, args.slug, None if args.off else args.why, actor=ACTOR))
        elif tc == "grant":
            attempt = os.environ.get("ALTITUDE_ATTEMPT")
            if ACTOR == "l2" and (args.slug != os.environ.get("ALTITUDE_TASK")
                                  or p != os.environ.get("ALTITUDE_PROJECT") or not attempt):
                sys.exit("alt task grant: an L2 records or revokes the grant only on its own task")
            if not args.revoke:
                if not (args.approval and args.question and args.revision):
                    sys.exit("alt task grant: --approval <message-id> --question <id> --revision <n> --reason <why>")
                out(T.record_grant(p, args.slug, args.approval, question=args.question, revision=args.revision,
                                   reason=args.reason, actor=ACTOR, source=args.source,
                                   expected_attempt=int(attempt) if ACTOR == "l2" else args.attempt,
                                   standing_policy=args.standing_policy, from_task=args.from_task))
            else:
                if any(value is not None for value in (args.standing_policy, args.from_task, args.attempt, args.approval,
                                                        args.question, args.revision)):
                    sys.exit("alt task grant --revoke: takes only --reason")
                out(T.revoke_grant(p, args.slug, args.reason, actor=ACTOR,
                                   expected_attempt=int(attempt) if ACTOR == "l2" else None))
        elif tc == "done":
            if ACTOR == "l2" and not os.environ.get("ALTITUDE_ATTEMPT"):
                sys.exit("alt task done: ALTITUDE_ATTEMPT is required for the L2")
            out(T.done(p, args.slug, actor=ACTOR, digest=Path(args.file).read_text() if args.file else args.digest,
                       expected_attempt=int(os.environ["ALTITUDE_ATTEMPT"]) if ACTOR == "l2" else None,
                       findings_tracked=args.findings_tracked))
        elif tc == "brief":
            out(str(T.brief(p, args.slug, _stdin_or_file(args), actor=ACTOR)))
        elif tc == "review":
            out(_task_review(args, p))
        elif tc == "reply":
            if ACTOR != "l2":
                sys.exit("alt task reply: only the current L2 may use this command")
            slug = os.environ.get("ALTITUDE_TASK")
            attempt = os.environ.get("ALTITUDE_ATTEMPT")
            if not slug or not attempt:
                sys.exit("alt task reply: ALTITUDE_TASK and ALTITUDE_ATTEMPT are required")
            words = args.text[1:] if args.text[:1] == [slug] else args.text
            if len(words) > 1:
                sys.exit("alt task reply: give one text or -, optionally after this task's slug")
            args.text = words[0] if words else "-"
            out(T.message(p, slug, "l2", _stdin_or_file(args), by="l2", expected_attempt=int(attempt)))
        elif tc in ("show", "status"):
            from altitude import status
            slug = args.slug or os.environ.get("ALTITUDE_TASK")
            if not slug:
                sys.exit("alt task status: slug or ALTITUDE_TASK required")
            record = status.status(p, slug)
            print(_brief_text(record)) if tc == "status" and args.brief else out(record)
        elif tc == "report":
            from altitude import status
            record = status.task_report(p, args.slug)
            out(record) if args.as_json else print(_report_text(record))
        elif tc == "events":
            count = max(0, args.last); rows = S.read_events(p, args.slug)
            rows = rows[-count:] if count else []
            out(rows) if args.as_json else print(_events_text(rows))
        elif tc == "messages":
            rows = T.task_messages(p, args.slug, args.last)
            out(rows) if args.as_json else print(_messages_text(rows))
        elif tc == "list":
            out([{**{k: t.get(k) for k in ("slug", "state", "title", "attempt", "updated")}, "waiting": T.wait_label(p, t)}
                 for t in S.list_tasks(p, include_archive=args.all)])
        return
    if c == "fyi":
        out(T.fyi(_project(args), args.slug, args.text, actor=ACTOR)); return
    if c == "decisions":
        from altitude import digest; out(digest.queue()); return
    if c == "monitor":
        from altitude import monitor, route
        out({"seats": route.seats(), "routing": monitor.routing(), "sessions": monitor.sessions()}); return
    if c == "queue":
        from altitude import digest
        record = digest.queue_status(); out(record) if args.as_json else print(_queue_text(record)); return
    if c == "repo":
        from altitude import status
        record = status.repo(_project(args)); out(record) if args.as_json else print(_repo_text(record)); return
    if c == "pr":
        from altitude import status
        if args.number is not None or not args.target.isdecimal() or int(args.target) < 1:
            ap.error("alt pr requires one positive PR number, or close NUMBER")
        record = status.pr(_project(args), int(args.target)); out(record) if args.as_json else print(_pr_text(record)); return
    if c == "l3":
        if args.l3cmd == "search":
            try:
                record = l3.search(_project(args), args.query, args.limit)
            except (ValueError, KeyError, OSError) as exc:
                sys.exit(f"alt l3 search: evidence unavailable: {exc}")
            print(json.dumps(record) if args.as_json else _search_text(record)); return
        record = l3.tool_summary(_project(args), args.days); out(record) if args.as_json else print(_tools_text(record)); return
    if c == "dispatch":
        from altitude import dispatch; out(dispatch.run(_project(args), args.slug, model=args.model)); return
    if c == "verify":
        from altitude import verify; out(verify.verify(_project(args), args.slug)); return
    if c == "poll":
        from altitude import dispatch; out(dispatch.poll(_project(args))); return
    if c == "land":
        from altitude import land
        try:
            out(land.land(args.message, project=args.project, pr_title=args.pr_title, pr_body_file=args.pr_body_file,
                          merge=args.merge, wait=args.wait, base=args.base,
                          test_cmd=args.test_cmd, dry_run=args.dry_run,
                          adopt_pr=args.adopt_pr, expected_head=args.expected_head, reason=args.reason,
                          closes_issues=args.closes_issue, approval=args.approval))
        except land.LandError as e:
            sys.exit(f"alt land: {e}")
        return
    if c == "chat":
        res = l3.turn(_project(args), _stdin_or_file(args), trigger=args.trigger, engine=args.engine, on_text=lambda t: (sys.stdout.write(t), sys.stdout.flush()))
        print(); out({k: res.get(k) for k in ("session_id", "context_percent", "turns", "cost", "error", "engine")}); return
    if c == "l3-reset":
        l3.reset(_project(args)); out("L3 will start fresh on the next turn"); return
    if c == "incident":
        from altitude import incidents; p = _project(args)
        if args.icmd == "new":
            filed = incidents.new_incident(p, title=args.title, task=args.task, what=args.what, evidence=args.evidence, cause=args.cause,
                                           tags=args.tag, actor=ACTOR)
            out({**filed, **incidents.publish_issue(p, filed["id"])})
        elif args.icmd == "amend":
            fields = {k: v for k, v in (("what", args.what), ("evidence", args.evidence), ("cause", args.cause), ("status", args.status), ("issue", args.issue)) if v is not None}
            try:
                out(incidents.amend_incident(p, args.id, reason=args.reason, actor=ACTOR, **fields))
            except ValueError as e:
                sys.exit(f"alt: {e}")
        elif args.icmd == "publish":
            try:
                out(incidents.publish_issue(p, args.id))
            except ValueError as e:
                sys.exit(f"alt: {e}")
        else:
            out(incidents.index(p))
        return
    if c == "serve":
        from altitude import server; server.main(host=args.host, port=args.port); return
    if c == "install-git-guards":
        from altitude import git_policy
        try:
            hooks_path = git_policy.install_hooks(Path.cwd())
        except git_policy.GitPolicyError as e:
            sys.exit(f"alt install-git-guards: {e}")
        out({"ok": True, "hooks_path": str(hooks_path)})
        return
    if c == "tls-init":
        from altitude import server; out(server.tls_init(args.ip)); return
    if c == "tls-share":
        if ACTOR != config.OPERATOR_ACTOR:
            sys.exit("alt tls-share: only the operator sets up devices")
        from altitude import tls
        try:
            tls.share()
        except tls.TLSFailure as exc:
            sys.exit(f"alt tls-share: {exc}")
        return
    if c == "voice":
        from altitude import speech
        if args.vcmd != "status" and ACTOR != config.OPERATOR_ACTOR:
            sys.exit(f"alt voice {args.vcmd}: only the operator sets up voice")
        try:
            if args.vcmd == "setup":
                files, _ = speech.manifest()
                if files is not None and speech.runtime() is None:
                    print(f"Downloading about {sum(f[2] for f in files) / 1e6:.0f} MB and checking each file…", file=sys.stderr)
                speech.setup()
            elif args.vcmd == "remove":
                speech.remove_runtime()
        except speech.SpeechError as exc:
            sys.exit(f"alt voice {args.vcmd}: {exc}")
        out(speech.status())
        return
    if c == "pair":
        if ACTOR != config.OPERATOR_ACTOR:
            sys.exit("alt pair: only the operator pairs devices")
        from altitude import access, tls
        code = access.issue_code()
        # The code works without the service, so a missing link never blocks recovering access.
        try:
            link = f"On the device, open {tls.service()['url']}/pair?code={code['code']}\nor type the code"
        except tls.TLSFailure as exc:
            link = f"No link: {exc}\nType the code"
        print(f"Pairing code: {code['code']} (one device, the next {code['minutes']} minutes)\n"
              f"{link} on its Pair this device screen. A new code cancels this one.")
        return


if __name__ == "__main__":
    try:
        main()
    except (T.TransitionError, ValueError) as e:
        sys.exit(f"alt: {e}")
