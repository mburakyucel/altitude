    args = ap.parse_args(argv)
    if DOOR:
        INPUTS.update(json.load(sys.stdin))
        sys.stdin = io.StringIO(INPUTS["stdin"])
    if "ALTITUDE_ACTOR" not in os.environ and config.RELEASE is not None and args.cmd != "update" and sys.stderr.isatty():
        from altitude import installation
        if notice := installation.update_notice():
            print(notice, file=sys.stderr)
    if args.cmd not in ("install", "update", "recover", "uninstall", "doctor", "service"):
        config.ensure_root()
    c = args.cmd
    if ACTOR == "project-agent-run":
        if c != "act":
            sys.exit("alt: a routine run reports in its final answer; its one verb is alt act")
        try:
            say(door.call("act", {"action": args.action, "target": args.target})["said"]); return
        except door.DoorError as exc:
            sys.exit(f"alt act: {exc}")
    if c == "act":
        sys.exit("alt act: only a routine run asks Altitude to change something, through its door")
    if c == "project" and args.pcmd in ("message", "terminal", "step"):
        sys.exit(f"alt project {args.pcmd} is available only through the project's coordinator socket")
    if c == "task" and args.tcmd == "offer":
        sys.exit("alt task offer is available only through the project's coordinator socket, during a chat turn")
    if c == "improve" and args.action != "status":
        sys.exit(f"alt improve {args.action} is available only through the project's coordinator socket")
    if c == "agent" and args.action == "offer":
        sys.exit("alt agent offer is available only through the project's coordinator socket, during a chat turn")
    closing_pr = c == "pr" and args.target == "close"
    actor_command = (c, getattr(args, "tcmd", None) if c == "task" else
                     getattr(args, "icmd", None) if c == "incident" else
                     getattr(args, "pcmd", None) if c == "project" else
                     getattr(args, "l3cmd", None) if c == "l3" else None)
    setup_command = c == "project" and args.pcmd == "setup"
    if c == "issue" or closing_pr:
        actor_command = (c, "close" if closing_pr else args.operation)
    if ACTOR == "l2":
        if actor_command not in L2_COMMANDS and c not in ("land", "fyi", "incident"):
            sys.exit(f"alt {c}: not available to an L2 worker; use project inspection or owned-task verbs")
        if c in ("repo", "pr", "l3") and _project(args) != os.environ.get("ALTITUDE_PROJECT"):
            sys.exit("alt: owner inspection is bound to the launch project")
        local = (c == "land" or actor_command in READ_COMMANDS
                 or actor_command in {("task", "run"), ("task", "validate"), ("task", "terminal")}
                 or actor_command == ("task", "review") and args.review_action in ("status", "run"))
        if DOOR and local:  # altd runs only what changes the task's records, never the worker's own commands
            sys.exit(f"alt {c}: the task door runs only verbs that change the task's records")
        if not local and (_project(args) != os.environ.get("ALTITUDE_PROJECT")
                          or getattr(args, "slug", None) not in (None, os.environ.get("ALTITUDE_TASK"))):
            sys.exit("alt: an L2 changes only its own project/task")
        if not DOOR and not local:
            return _forward(args, list(sys.argv[1:] if argv is None else argv), " ".join(filter(None, actor_command)))
    if ACTOR == "l3" and actor_command not in L3_COMMANDS:
        sys.exit(f"alt {c}: not available to an L3 coordinator; use the documented inspection and task-coordination verbs")
    if os.environ.get("ALTITUDE_REPAIR") and actor_command not in REPAIR_COMMANDS:
        sys.exit(f"alt {c}: not available in a repair, which acts on this installation; decisions stay with the operator")
    if closing_pr and (args.number is None or args.number < 1 or args.as_json):
        ap.error("alt pr close requires one positive PR number and no options")
    machine_run = c == "task" and args.tcmd == "run"
    validation_run = c == "task" and args.tcmd == "validate"
    if validation_run:
        args.slug = os.environ.get("ALTITUDE_TASK")
        args.command = args.command[1:] if args.command[:1] == ["--"] else args.command
        if ACTOR != "l2" or not args.slug or not os.environ.get("ALTITUDE_ATTEMPT"):
            sys.exit("alt task validate: only the current L2 runs validation, and only for its own task")
        if args.container_browser and (args.command or args.kvm or args.publish is not None or args.simulator or args.capture):
            ap.error("alt task validate: --container-browser takes no command or other lane options")
        if not args.command and not args.container_browser:
            ap.error("alt task validate: give the command after --")
        from altitude import platform
        platform.end_with_parent()   # a cancelled launcher ends this client, which stops its run
    terminal_read = c == "task" and args.tcmd == "terminal"
    if terminal_read:
        args.slug = args.slug or os.environ.get("ALTITUDE_TASK")
        if ACTOR != "l2" or args.slug != os.environ.get("ALTITUDE_TASK") or not os.environ.get("ALTITUDE_ATTEMPT"):
            sys.exit("alt task terminal: only the current L2 reads its own task's terminal")
    review_run = c == "task" and args.tcmd == "review" and args.review_action == "run"
    if review_run:
        args.slug = args.slug or os.environ.get("ALTITUDE_TASK")
        if (ACTOR != "l2" or args.slug != os.environ.get("ALTITUDE_TASK")
                or _project(args) != os.environ.get("ALTITUDE_PROJECT") or not os.environ.get("ALTITUDE_ATTEMPT")):
            sys.exit("alt task review run: only the current L2 runs reviews for its own task and project")
    if machine_run and (ACTOR != "l2" or args.slug != os.environ.get("ALTITUDE_TASK") or not os.environ.get("ALTITUDE_ATTEMPT")):
        sys.exit("alt task run: only the current L2 runs commands, and only for its own task")
    if c == "issue" or closing_pr or setup_command or machine_run or validation_run or review_run or terminal_read:
        import ssl
        import urllib.error
        import urllib.request
        body = "" if setup_command or machine_run or validation_run or review_run or terminal_read or sys.stdin.isatty() and (closing_pr or args.operation in ("close", "label")) else sys.stdin.read()
        payload = {"project": _project(args), "slug": args.slug, "attempt": os.environ["ALTITUDE_ATTEMPT"],
                   "review_id": args.review_id, "context_ids": args.context_message, "proposal_id": args.proposal_message,
                   "show": _sent_show(args, "task review run")} if review_run else {"project": _project(args), "slug": args.slug, "attempt": os.environ["ALTITUDE_ATTEMPT"]} if terminal_read else {"project": _project(args), "slug": args.slug, "attempt": os.environ["ALTITUDE_ATTEMPT"], "command": args.command, "request": uuid.uuid4().hex} if machine_run else {"project": _project(args), "slug": args.slug, "attempt": os.environ["ALTITUDE_ATTEMPT"], "command": args.command, "kvm": args.kvm, "publish": args.publish, "simulator": args.simulator, "capture": args.capture, "container_browser": args.container_browser} if validation_run else {"project": args.name, "action": "repair", "reason": args.reason} if setup_command else {"project": _project(args), "number": args.number, "body": body} if closing_pr else {
                   "project": _project(args), "operation": args.operation, "body": body,
                   **{key: getattr(args, key) for key in ("title", "labels", "number", "reason", "add", "remove") if hasattr(args, key)}}
        # An option left unset sends nothing, so a checkout awaiting activation keeps working against the older
        # running service, whose handlers refuse fields they do not know; each handler reads absence as that default.
        payload = {key: value for key, value in payload.items() if value is not None and value is not False}
        # L3 uses its runtime shim/socket; HTTP is the operator's existing daemon surface.
        if ACTOR == "l3":
            sys.exit(f"alt {c}: L3 must use its project-bound runtime alt socket")
        if setup_command and (bool(args.repair) != bool(args.reason and args.reason.strip())):
            ap.error("project setup --repair requires --reason; reads accept no reason")
        from altitude import access, tls, validation
        from urllib.parse import quote
        owned = review_run or terminal_read or machine_run or validation_run  # admitted by the owner's job, not the key
        endpoint = "task/review/run" if review_run else "task/terminal" if terminal_read else "task/run" if machine_run else "task/validate" if validation_run else ("project/setup" if args.repair else "setup/" + quote(args.name, safe="")) if setup_command else "pr/close" if closing_pr else "issue"
        try:
            data = (None if setup_command and not args.repair else door.request_body(payload) if owned
                    else json.dumps(payload).encode())
        except door.DoorError as exc:
            sys.exit(f"alt task {args.tcmd}: {exc}")
        import http.client
        import time
        # A restart can end a machine command's connection while its unit runs on; asking again with the same
        # request waits for that command's result instead of running it again.
        reconnect_until = time.monotonic() + config.MACHINE_COMMAND_WAIT + config.MACHINE_COMMAND_TIMEOUT + 120
        reconnecting = False
        activating_until = None

        def wait_for_activation() -> None:
            """A validation request that pending activation turned away, even after waiting its turn, waits and asks
            again: the line lives in altd, which restarts to activate (docs/DEVELOPMENT.md#validation-runner)."""
            nonlocal activating_until
            if activating_until is None:
                activating_until = time.monotonic() + validation.WAIT
                print("[altitude] Altitude restarts soon to apply an update; this request asks again once it has "
                      "restarted", file=sys.stderr, flush=True)
            if time.monotonic() >= activating_until:
                sys.exit(f"alt task validate: Altitude did not restart for its update within "
                         f"{validation.WAIT // 60} minutes; try again")
            time.sleep(validation.WATCH_SECONDS)
        while True:
            # The running service's record, not this process's launch environment, says where altd listens and
            # which CA proves it, read afresh for each attempt, so a restart onto another certificate folder or
            # port strands neither a running worker nor a command waiting across that restart.
            try:
                found = tls.service()
            except tls.TLSFailure as exc:
                if activating_until is not None:   # restarting
                    wait_for_activation()
                    continue
                sys.exit(f"alt {c}: altd unavailable: {exc}")
            from altitude import platform
            service_url = f"https://localhost:{found['port']}" if platform.containerized() else found["url"]
            request = urllib.request.Request(f"{service_url}/api/{endpoint}",
                                             data=data,
                                             headers={"Content-Type": "application/json",
                                                      **({} if owned else {access.KEY_HEADER: access.machine_key() or ""}),
                                                      **({"Accept": "application/x-ndjson"} if machine_run or validation_run else {})})
            context = ssl.create_default_context(cadata=found["ca"]) if found["tls"] else None
            try:
                with urllib.request.urlopen(request, context=context, timeout=None if review_run else config.MACHINE_COMMAND_TIMEOUT + 60 if machine_run else validation.TIMEOUT + 600 + (validation.SIMULATOR_SECONDS if args.simulator else 0) if validation_run else 130) as response:
                    if machine_run or validation_run:  # what a busy machine makes the request wait for, a line at a time, then the answer
                        result, shown = {}, None
                        for line in response:
                            result = json.loads(line)
                            if result.keys() == {"waiting"} and result["waiting"] != shown:
                                shown = result["waiting"]
                                print(f"[altitude] {S.localized(shown)}", file=sys.stderr, flush=True)
                        if "unit" not in result and result.get("error"):
                            if validation_run and result["error"] == validation.RESTARTING:
                                wait_for_activation()
                                continue
                            sys.exit(S.localized(result["error"]))
                        if "unit" not in result:
                            if machine_run:  # a restart ended the connection: ask again for this request's result
                                raise ConnectionResetError("altd ended the connection before the command's result")
                            sys.exit("alt task validate: altd ended the connection before the run's result")
                    else:
                        result = json.load(response)
                    if review_run and not result.get("ok"):
                        sys.exit(result.get("error", "Review execution failed"))
                    if terminal_read:
                        from altitude import terminal
                        out(result) if args.as_json else print(terminal.describe(result, "task"))
                        return
                    if machine_run or validation_run:
                        sys.stdout.write(result["output"])
                        ended = result.get("ended", "exit")
                        print(f"[altitude] {result['unit']}: exit {result['exit']}"
                              + (f"; {ended}" if ended != "exit" else "")
                              + (f"; {result['error']}" if result.get("error") else "")
                              + (f"; {result['cleanup']}" if result.get("cleanup") else "")
                              + ("; output truncated, read the log" if result.get("output_truncated") else "")
                              + f"; log {result['log']}"
                              + (f"; results {result['results']}; commit {result['commit']} tree {result['tree']}; "
                                 f"{result['host']}; {result['isolation']}" if validation_run else "")
                              + ("; " + ", ".join(str(result["simulator"].get(key)) for key in (
                                  "device", "runtime", "safari", "xcode", "screenshot", "capture") if result["simulator"].get(key))
                                 if validation_run and result.get("simulator") else ""))
                        # Only a command that exited 0 and whose run ended cleanly is a success.
                        code = 124 if result["timed_out"] else result["exit"] if ended == "exit" else 1
                        sys.exit(1 if code is None else code)
                    out(result["review"] if review_run else result if closing_pr or setup_command else result["url"])
            except urllib.error.HTTPError as exc:
                if exc.code == 401:
                    sys.exit(f"alt {c}: altd refused this machine's key; read access to {access.DIR / 'machine.key'} is required")
                error = json.load(exc).get("error", str(exc))
                if validation_run and error == validation.RESTARTING:
                    wait_for_activation()
                    continue
                sys.exit(("" if machine_run or validation_run else f"alt {c}: ") + error)
            except (OSError, http.client.HTTPException, ValueError) as exc:
                if activating_until is not None and isinstance(exc, urllib.error.URLError):   # restarting
                    wait_for_activation()
                    continue
                # urllib reports a failure to connect or send as URLError: altd never received that request.
                if machine_run and (reconnecting or not isinstance(exc, urllib.error.URLError)) \
                        and time.monotonic() < reconnect_until:
                    if not reconnecting:
                        print(f"[altitude] the connection to altd ended ({exc}); waiting for this command's result",
                              file=sys.stderr)
                    reconnecting = True
                    time.sleep(2)
                    continue
                if isinstance(getattr(exc, "reason", None), ssl.SSLCertVerificationError):
                    sys.exit(f"alt {c}: altd at {found['url']} does not prove its identity with "
                             f"{found['tls_dir'] / 'ca.crt' if found['ca'] else 'the system trust store'}: "
                             f"{exc.reason.verify_message}")
                sys.exit(f"alt {c}: altd unavailable: {exc}")
            break
        return
    if c == "repair":
        from altitude import repair
        try:
            if args.repair_action == "report":
                repair.report(args.wrong, args.changed, args.remains, args.tried)
                print("Report recorded. Altitude checks the result once the repair ends.")
                return
            if args.repair_action == "ask":
                repair.ask(args.reason, args.command, args.step)
                print("Asked on the repair's page. End your turn now; the operator's answer arrives as your next message.")
                return
            sys.exit(repair.start(args.problem, args.engine))
        except repair.Refused as exc:
            sys.exit(str(exc))
    if c in ("install", "update", "recover", "uninstall", "doctor", "service"):
        from altitude import installation
        if os.environ.get("ALTITUDE_REPAIR") and (c in ("install", "update", "recover")
                                                   or c == "service" and args.operation in ("stop", "configure")):
            from altitude import repair
            repair.note_restarting()
        try:
            if c == "install":
                result = installation.install(args.archive, args.sha256, args.prefix)
            elif c == "update":
                if (args.archive is None) != (args.sha256 is None) or (args.archive and args.version):
                    ap.error("update takes --archive with --sha256, or --version, or neither for the latest release")
                result = (installation.install(args.archive, args.sha256, installation._prefix()) if args.archive
                          else installation.update(args.version))
            elif c == "service":
                if args.operation == "configure":
                    if not args.host or args.directory:
                        ap.error("service configure requires --host and does not take --directory")
                    result = installation.configure_address(args.host, apply=args.apply)
                elif args.operation == "prepare-tls":
                    if args.host:
                        ap.error("--host requires service configure")
                    if args.directory is None:
                        ap.error("service prepare-tls requires --directory")
                    from altitude import source_tls
                    result = source_tls.prepare(args.directory, apply=args.apply)
                else:
                    if args.directory is not None or args.apply or args.host:
                        ap.error("--directory, --host and --apply require service prepare-tls or configure")
                    result = installation.service(args.operation)
            else:
                result = getattr(installation, c)()
            if c == "doctor" and not args.as_json:
                print(installation.describe_doctor(result))
            elif c == "service" and args.operation == "status" and not args.as_json:
                print(installation.describe_hosting(installation.hosting_status(result)))
            elif c == "service" and args.operation == "status":
                out({**result, "hosting": installation.hosting_status(result)})
            else:
                out(result)
        except (ValueError, RuntimeError, OSError) as exc:
            sys.exit(f"alt {c}: {exc}")
        return
    if c == "machine":
        from altitude import dispatch
        if args.mcmd == "set":
            if args.voice is not None or args.unset_voice:
                out(dispatch.request_setting(None, "voice", None if args.unset_voice else args.voice, args.reason, actor=ACTOR))
            elif args.new_tasks is not None or args.unset_new_tasks:
                out(dispatch.request_setting(None, "new_tasks", None if args.unset_new_tasks else args.new_tasks, args.reason, actor=ACTOR))
            elif args.projects_folder is not None or args.unset_projects_folder:
                value = None if args.unset_projects_folder else str(Path(args.projects_folder).expanduser().absolute())
                out(dispatch.request_setting(None, "projects_folder", value, args.reason, actor=ACTOR))
            else:
                out(dispatch.request_setting(None, "wip", args.wip, args.reason, actor=ACTOR))
        else:
            # Pending and historical voice receipts may contain private service details.
            voice_request = S.read_json(config.ROOT / "voice-request.json", None)
            if isinstance(voice_request, dict):
                voice_request = {k: config.voice_receipt(v) for k, v in voice_request.items()}
            voice = config.voice_setting()
            out({"wip": config.machine_wip(), "override": config.machine_settings().get("wip"),
                 "default": config.WIP_PER_MACHINE, "machine_runs": config.MACHINE_RUNS,
                 "request": S.read_json(config.ROOT / "wip-request.json", None),
                 "voice": {"backend": voice["backend"]},
                 "voice_request": voice_request,
                 "projects_folder": [str(root) for root in config.project_roots()],
                 "new_tasks": config.machine_settings().get("new_tasks"),
                 "new_tasks_request": S.read_json(config.ROOT / "new_tasks-request.json", None),
                 "projects_folder_request": S.read_json(config.ROOT / "projects_folder-request.json", None)})
        return
    if c == "project":
        if args.pcmd == "set":
            from altitude import dispatch
            if ACTOR == "l3" and args.name != _project(args):
                sys.exit("alt project set: the L3 socket fixes the project")
            setting = next(key for key in config.PROJECT_SETTINGS
                           if getattr(args, key) is not None or getattr(args, f"unset_{key}"))
            out(dispatch.request_setting(args.name, setting, getattr(args, setting), args.reason, actor=ACTOR))
            return
        if args.pcmd == "discover":
            out(config.discover_projects())
            return
        if args.pcmd == "add":
            try:
                with config.add_project(args.name, path=args.path, approval=args.approval,
                                        l2_engine=args.l2_engine) as entry:
                    out(entry)
                S.regen_state_md(args.name)
                project_setup.registered(args.name)
            except ValueError as exc:
                sys.exit(f"alt: {exc}")
        elif args.pcmd == "remove":
            config.remove_project(args.name); out("removed")
        else:
            out(config.load_projects())
        return
    if c == "state":
        say(S.regen_state_md(_project(args))); return
    if c == "task":
        p = _project(args); tc = args.tcmd
        if tc == "new":
            # The coordinator socket names the reply a Create task press answers; nothing else sets it.
            offer_turn = os.environ.get("ALTITUDE_OFFER_TURN") if ACTOR == "l3" else None
            out(T.new(p, args.title, _stdin_or_file(args), actor=ACTOR, source=args.source, model=args.model, engine=args.engine, effort=args.effort, paths=(args.paths or "").split(",") if args.paths else None, hold_merge=args.hold_merge, image_ids=args.image_ids, wait=args.wait, after=args.after, offer_turn=offer_turn, improvement=args.improvement))
        elif tc == "release":
            out(T.release(p, args.slug, args.reason, actor=ACTOR))
        elif tc in ("reject", "resume", "stop", "preserve-checkout", "handoff"):
            from altitude import dispatch
            if tc == "handoff" and args.request:
                if not (args.now or args.cancel) or args.engine or args.attempt is not None:
                    ap.error("handoff --request requires --now or --cancel, without --engine/--attempt")
                out(dispatch.handoff_control(p, args.slug, args.request, "now" if args.now else "cancel",
                                             actor=ACTOR, reason=args.reason))
            else:
                if tc == "handoff" and (args.cancel or not args.engine or args.attempt is None):
                    ap.error("new handoff requires --engine and --attempt; cancellation requires --request")
                options = {"engine": args.engine, "expected_attempt": args.attempt,
                           "handoff_now": args.now} if tc == "handoff" else {}
                out(dispatch.request_task_operation(p, args.slug, tc, args.reason, actor=ACTOR, **options))
        elif tc == "recheck-ci":
            out(T.recheck_ci(p, args.slug, args.run, args.at, args.reason, actor=ACTOR))
        elif tc == "block":
            if args.standing_policy is None:
                questions, args.reason = _question_input(args, args.reason)
            elif ACTOR != "l2" or any((args.reason, args.questions_file, args.show, args.fault, args.for_operator,
                                       args.recommendation, args.label, args.why)):
                sys.exit("alt task block --standing-policy: the current L2's whole question to L3; "
                         "put task-specific steps in a reply first")
            else:
                questions = None
            if args.show and (ACTOR != "l2" or args.slug != os.environ.get("ALTITUDE_TASK")
                              or p != os.environ.get("ALTITUDE_PROJECT") or not os.environ.get("ALTITUDE_ATTEMPT")
                              or args.fault):
                sys.exit("alt task block --show: only the current L2's own project/task, without --fault")
            if args.fault and questions is not None:
                sys.exit("alt task block: --fault needs --reason, not questions JSON")
            if ACTOR == "l2":
                attempt = os.environ.get("ALTITUDE_ATTEMPT")
                if args.slug != os.environ.get("ALTITUDE_TASK") or not attempt:
                    sys.exit("alt task block: an L2 blocks only its own task (ALTITUDE_TASK, ALTITUDE_ATTEMPT)")
                if args.fault:
                    if S.load_task(p, args.slug).get("attempt") != int(attempt):
                        sys.exit(f"alt task block: attempt {attempt} is no longer current")
                else:
                    waiting = T.OPERATOR_MESSAGE_ROLE if args.for_operator else "l3"
                    if note := T.observe_held_pr(p, args.slug, by="l2"):
                        print(f"alt task block: {note}; the held review card keeps the recorded delivery",
                              file=sys.stderr)
                    blocked = T.block(p, args.slug, args.reason, actor="l2", expected_state="running",
                                      expected_attempt=int(attempt), updates={"waiting_on": waiting},
                                      recommendation=args.recommendation, recommendation_label=args.label,
                                      recommendation_why=args.why, questions=questions, show=_shown(args, p),
                                      tell_l3=True, standing_policy=args.standing_policy)
                    if args.show:
                        asked = T.shown_question(questions)["question"] if questions else args.reason
                        question = next(q for q in reversed(blocked["questions"])
                                        if q["status"] == "open" and q["detail"].strip() == asked.strip())
                        out({**blocked, "view_url": T.shown_url(p, args.slug, question["id"], question["revision"])})
                    else:
                        out(blocked)
            elif not args.fault:
                out(T.block(p, args.slug, args.reason, actor=ACTOR, updates={"waiting_on": T.OPERATOR_MESSAGE_ROLE},
                            questions=questions, recommendation=args.recommendation,
                            recommendation_label=args.label, recommendation_why=args.why))
            if args.fault:
                # An environment fault is Altitude's to fix, not a question for the operator: the same path as a fault
                # altd detects itself (block, one incident per kind per day, one message for L3).
                from altitude import incidents
                out(incidents.system_fault(f"worker:{args.slug}", args.reason, project=p, task=args.slug)
                    or {"state": "blocked", "note": "this fault was already filed today; L3 was told once"})
        elif tc == "escalate":
            questions, args.question = _question_input(args, args.question)
            out(T.escalate(p, args.slug, args.question, actor=ACTOR, recommendation=args.recommendation,
                          recommendation_label=args.label, recommendation_why=args.why, questions=questions))
        elif tc == "resolve":
            attempt = os.environ.get("ALTITUDE_ATTEMPT")
            if (ACTOR != "l2" or args.slug != os.environ.get("ALTITUDE_TASK")
                    or p != os.environ.get("ALTITUDE_PROJECT") or not attempt):
                sys.exit("alt task resolve: only the current L2 may resolve its own task question")
            out(T.resolve_question(p, args.slug, args.question, args.revision, args.message,
                                   expected_attempt=int(attempt), source=args.source, disposition=args.disposition,
                                   reason=args.reason, remaining=args.remaining, for_operator=args.for_operator,
                                   recommendation=args.recommendation,
                                   recommendation_label=args.label, recommendation_why=args.why,
                                   l3_authority=args.l3_authority))
        elif tc == "message":
            if ACTOR == "l3" and not (args.summary or "").strip():
                sys.exit("alt task message: L3 adds --summary '<one line saying what the message is about>'")
            message = T.message(p, args.slug, "l3" if ACTOR == "l3" else T.OPERATOR_MESSAGE_ROLE, _stdin_or_file(args), by=ACTOR, image_ids=args.image_ids, summary=args.summary)
            out(message)
        elif tc == "paths":
            declared = [x.strip() for x in args.paths.split(",") if x.strip()]
            if not declared:
                sys.exit("alt task paths: no paths named")
            with S.project_lock(p):
                task = S.load_task(p, args.slug)
                previous = task.get("paths") or []
                task["paths"] = declared
                S.save_task(p, task)
                S.append_event(p, args.slug, "paths", by=ACTOR, previous=previous, paths=declared)
            S.regen_state_md(p)
            out(task)
        elif tc == "hold-merge":
            if args.approval or args.pr is not None or args.head or args.reason:
                sys.exit("alt task hold-merge --approval: use the project-bound L3 daemon socket")
            if not args.off and not args.why:
                sys.exit("alt task hold-merge: --why <reason> (or --off)")
            if args.off and ACTOR != config.OPERATOR_ACTOR:
                sys.exit("alt task hold-merge: only the operator may release a merge hold")
            out(T.set_hold_merge(p, args.slug, None if args.off else args.why, actor=ACTOR))
        elif tc == "grant":
            attempt = os.environ.get("ALTITUDE_ATTEMPT")
            if ACTOR == "l2" and (args.slug != os.environ.get("ALTITUDE_TASK")
                                  or p != os.environ.get("ALTITUDE_PROJECT") or not attempt):
                sys.exit("alt task grant: an L2 records or revokes the grant only on its own task")
            if args.withdraw is not None:
                if args.revoke or any(value is not None for value in (args.standing_policy, args.from_task, args.attempt,
                                                                       args.approval, args.question, args.revision)):
                    sys.exit("alt task grant --withdraw <approval>: takes only --reason")
                out({"withdrawn": args.withdraw, "ended": T.withdraw_approval(p, args.slug, args.withdraw, args.reason,
                                                                              actor=ACTOR)})
            elif not args.revoke:
                if not (args.approval and args.question and args.revision):
                    sys.exit("alt task grant: --approval <message-id> --question <id> --revision <n> --reason <why>")
                out(T.record_grant(p, args.slug, args.approval, question=args.question, revision=args.revision,
                                   reason=args.reason, actor=ACTOR, source=args.source,
                                   expected_attempt=int(attempt) if ACTOR == "l2" else args.attempt,
                                   standing_policy=args.standing_policy, from_task=args.from_task))
            else:
                if any(value is not None for value in (args.standing_policy, args.from_task, args.attempt, args.approval,
                                                        args.question, args.revision)):
                    sys.exit("alt task grant --revoke: takes only --reason")
                out(T.revoke_grant(p, args.slug, args.reason, actor=ACTOR,
                                   expected_attempt=int(attempt) if ACTOR == "l2" else None))
        elif tc == "done":
            if ACTOR == "l2" and not os.environ.get("ALTITUDE_ATTEMPT"):
                sys.exit("alt task done: ALTITUDE_ATTEMPT is required for the L2")
            out(T.done(p, args.slug, actor=ACTOR, digest=_read(args.file) if args.file else args.digest,
                       expected_attempt=int(os.environ["ALTITUDE_ATTEMPT"]) if ACTOR == "l2" else None,
                       findings_tracked=args.findings_tracked))
        elif tc == "save":
            if ACTOR != "l2" or not os.environ.get("ALTITUDE_TASK") or not os.environ.get("ALTITUDE_ATTEMPT"):
                sys.exit("alt task save: only the current L2 saves its own task's report and progress")
            out(T.save_owner_file(p, os.environ["ALTITUDE_TASK"], args.kind, sys.stdin.read() if args.file == "-" else _read(args.file),
                                  expected_attempt=int(os.environ["ALTITUDE_ATTEMPT"])))
        elif tc == "brief":
            out(str(T.brief(p, args.slug, _stdin_or_file(args), actor=ACTOR)))
        elif tc == "review":
            out(_task_review(args, p))
        elif tc == "reply":
            if ACTOR != "l2":
                sys.exit("alt task reply: only the current L2 may use this command")
            slug = os.environ.get("ALTITUDE_TASK")
            attempt = os.environ.get("ALTITUDE_ATTEMPT")
            if not slug or not attempt:
                sys.exit("alt task reply: ALTITUDE_TASK and ALTITUDE_ATTEMPT are required")
            words = args.text[1:] if args.text[:1] == [slug] else args.text
            if len(words) > 1:
                sys.exit("alt task reply: give one text or -, optionally after this task's slug")
            args.text = words[0] if words else "-"
            row = T.message(p, slug, "l2", _stdin_or_file(args), by="l2", expected_attempt=int(attempt),
                            capture_run=args.capture, to_l3=args.to == "l3", show=_shown(args, p))
            out({**row, "view_url": T.shown_url(p, slug, row["id"])} if row.get("shown") else row)
        elif tc in ("show", "status"):
            from altitude import status
            slug = args.slug or os.environ.get("ALTITUDE_TASK")
            if not slug:
                sys.exit("alt task status: slug or ALTITUDE_TASK required")
            record = status.status(p, slug)
            say(_brief_text(record)) if tc == "status" and args.brief else out(record)
        elif tc == "report":
            from altitude import status
            record = status.task_report(p, args.slug)
            out(record) if args.as_json else say(_report_text(record))
        elif tc == "events":
            count = max(0, args.last); rows = S.read_events(p, args.slug)
            rows = rows[-count:] if count else []
            out(rows) if args.as_json else say(_events_text(rows))
        elif tc == "messages":
            rows = T.task_messages(p, args.slug, args.last)
            out(rows) if args.as_json else say(_messages_text(rows))
        elif tc == "list":
            out([{**{k: t.get(k) for k in ("slug", "state", "title", "attempt", "updated")}, "waiting": T.wait_label(p, t)}
                 for t in S.list_tasks(p, include_archive=args.all)])
        return
    if c == "fyi":
        out(T.fyi(_project(args), args.slug, args.text, actor=ACTOR)); return
    if c == "decisions":
        from altitude import digest; out(digest.queue()); return
    if c == "monitor":
        from altitude import monitor, route
        out({"seats": route.seats(), "routing": monitor.routing(), "sessions": monitor.sessions()}); return
    if c == "queue":
        from altitude import digest
        record = digest.queue_status(); out(record) if args.as_json else say(_queue_text(record)); return
    if c == "repo":
        from altitude import status
        record = status.repo(_project(args)); out(record) if args.as_json else say(_repo_text(record)); return
    if c == "pr":
        from altitude import status
        if args.number is not None or not args.target.isdecimal() or int(args.target) < 1:
            ap.error("alt pr requires one positive PR number, or close NUMBER")
        record = status.pr(_project(args), int(args.target)); out(record) if args.as_json else say(_pr_text(record)); return
    if c == "l3":
        if args.l3cmd == "search":
            try:
                record = l3.search(_project(args), args.query, args.limit)
            except (ValueError, KeyError, OSError) as exc:
                sys.exit(f"alt l3 search: evidence unavailable: {exc}")
            print(json.dumps(record)) if args.as_json else say(_search_text(record)); return
        record = l3.tool_summary(_project(args), args.days); out(record) if args.as_json else say(_tools_text(record)); return
    if c == "improve":
        out(improve.status(_project(args), args.run)); return
    if c == "agent":
        from altitude import project_agents
        stdin = sys.stdin.read() if "-" in (getattr(args, "brief", None), getattr(args, "text", None)) else ""
        try:
            result = project_agents.verb(_project(args), args, stdin, by="operator", source="cli")
        except project_agents.Refused as exc:
            sys.exit(f"Not sent: {exc}" if args.action == "send" else f"alt agent: {exc}")
        except (ValueError, KeyError) as exc:
            sys.exit(f"alt agent: {exc}")
        if args.action == "send":
            say(f"Sent to {result['name']}." if result["sent"] else "Already received."); return
        out(result)
        return
    if c == "dispatch":
        from altitude import dispatch; out(dispatch.run(_project(args), args.slug, model=args.model)); return
    if c == "verify":
        from altitude import verify; out(verify.verify(_project(args), args.slug)); return
    if c == "poll":
        from altitude import dispatch; out(dispatch.poll(_project(args))); return
    if c == "land":
        from altitude import land
        try:
            out(land.land(args.message, project=args.project, pr_title=args.pr_title, pr_body_file=args.pr_body_file,
                          merge=args.merge, wait=args.wait, base=args.base,
                          test_cmd=args.test_cmd, dry_run=args.dry_run,
                          adopt_pr=args.adopt_pr, expected_head=args.expected_head, reason=args.reason,
                          closes_issues=args.closes_issue, approval=args.approval))
        except land.LandError as e:
            sys.exit(f"alt land: {e}")
        return
    if c == "chat":
        res = l3.turn(_project(args), _stdin_or_file(args), trigger=args.trigger, engine=args.engine, on_text=lambda t: (sys.stdout.write(t), sys.stdout.flush()))
        print(); out({k: res.get(k) for k in ("session_id", "context_percent", "turns", "cost", "error", "engine", "queued")}); return
    if c == "l3-reset":
        l3.reset(_project(args)); out("L3 will start fresh on the next turn"); return
    if c == "incident":
        from altitude import incidents; p = _project(args)
        if args.icmd == "new":
            filed = incidents.new_incident(p, title=args.title, task=args.task, what=args.what, evidence=args.evidence, cause=args.cause,
                                           tags=args.tag, actor=ACTOR)
            out({**filed, **incidents.publish_issue(p, filed["id"])})
        elif args.icmd == "amend":
            fields = {k: v for k, v in (("what", args.what), ("evidence", args.evidence), ("cause", args.cause), ("status", args.status), ("issue", args.issue)) if v is not None}
            try:
                out(incidents.amend_incident(p, args.id, reason=args.reason, actor=ACTOR, **fields))
            except ValueError as e:
                sys.exit(f"alt: {e}")
        elif args.icmd == "publish":
            try:
                out(incidents.publish_issue(p, args.id, anyway=True))
            except ValueError as e:
                sys.exit(f"alt: {e}")
        else:
            out(incidents.index(p))
        return
    if c == "serve":
        from altitude import server; server.main(host=args.host, port=args.port); return
    if c == "install-git-guards":
        from altitude import git_policy
        try:
            hooks_path = git_policy.install_hooks(Path.cwd())
        except git_policy.GitPolicyError as e:
            sys.exit(f"alt install-git-guards: {e}")
        out({"ok": True, "hooks_path": str(hooks_path)})
        return
    if c == "tls-init":
        from altitude import server; out(server.tls_init(args.ip)); return
    if c == "tls-share":
        if ACTOR != config.OPERATOR_ACTOR:
            sys.exit("alt tls-share: only the operator sets up devices")
        from altitude import tls
        try:
            tls.share()
        except tls.TLSFailure as exc:
            sys.exit(f"alt tls-share: {exc}")
        return
    if c == "trust":
        if ACTOR != config.OPERATOR_ACTOR:
            sys.exit("alt trust: only the operator changes this computer's trust")
        from altitude import tls
        try:
            trusted = tls.trust()
        except tls.TLSFailure as exc:
            sys.exit(f"alt trust: {exc}")
        sys.exit(0 if trusted else 1)
    if c == "voice":
        from altitude import speech
        if args.vcmd != "status" and ACTOR != config.OPERATOR_ACTOR:
            sys.exit(f"alt voice {args.vcmd}: only the operator sets up voice")
        try:
            if args.vcmd == "setup":
                files, _ = speech.manifest()
                if files is not None and speech.runtime() is None:
                    print(f"Downloading about {sum(f[2] for f in files) / 1e6:.0f} MB and checking each file…", file=sys.stderr)
                speech.setup()
            elif args.vcmd == "remove":
                speech.remove_runtime()
            elif args.vcmd == "cancel":
                speech.cancel_setup()
        except speech.SpeechError as exc:
            sys.exit(f"alt voice {args.vcmd}: {exc}")
        out(speech.status())
        return
    if c == "sign-in":
        if ACTOR != config.OPERATOR_ACTOR:
            sys.exit("alt sign-in: only the operator signs Altitude in")
        label = config.ENGINE_LABELS[args.engine]
        signing = {"attempt": None}
        try:
            signing = _sign_in_request(args.engine, {"action": "start"})
            if signing["state"] == "waiting":
                print(f"Open this link, approve Altitude, then paste the code {label} shows:\n\n  {signing['link']}\n")
                code = input("Code: ")
                signing = _sign_in_request(args.engine, {"action": "finish", "attempt": signing["attempt"], "code": code})
        except (KeyboardInterrupt, EOFError):
            # Interrupted while it opened, the open sign-in is this one: starting replaced any other.
            _sign_in_request(args.engine, {"action": "cancel", **({"attempt": signing["attempt"]} if signing["attempt"] else {})})
            sys.exit("\nalt sign-in: cancelled; nothing changed")
        if signing["state"] != "done":
            sys.exit(f"alt sign-in: {signing.get('error') or 'The sign-in did not finish.'}")
        print(f"Altitude's {label} runs now use this sign-in. Your own is unchanged.")
        return
    if c == "pair":
        if ACTOR != config.OPERATOR_ACTOR:
            sys.exit("alt pair: only the operator pairs devices")
        from altitude import access, qr, tls
        code = access.issue_code()
        print(f"Pairing code: {code['code']} (one device, the next {code['minutes']} minutes). "
              "A new code cancels this one.")
        # The code works without the service, so a missing address never blocks recovering access. The code
        # never rides in a link: the device opens the address before it trusts Altitude's certificate.
        try:
            found = tls.service()
        except tls.TLSFailure as exc:
            print(f"Type the code on the device's Pair this device screen. No address: {exc}")
            return
        print(f"Open Altitude: {found['url']}")
        try:
            tls.phone_address(found)
            print("Or scan this with a phone to open it:\n" + qr.terminal(found["url"]))
        except tls.TLSFailure as exc:
            print("Other devices can't reach this address yet — see Settings → Network." if found["tls"] else f"No phone QR: {exc}")
        if found["tls"] and (found["tls_dir"] / "ca.crt").exists():  # an external certificate has no CA here
            try:
                authority = tls.identity(found["tls_dir"] / "ca.crt")
                print(f"Before installing Altitude's certificate there, check it is named {authority['name']} and "
                      f"its full SHA-256 is:\n  {authority['sha256']}")
            except (tls.TLSFailure, OSError) as exc:
                print(f"Altitude's certificate cannot be read to check it: {exc}")
            print("Compare the certificate independently with this terminal, import it, then reopen this exact URL "
                  "in a new private window without a warning before entering the code. Stop if the identity differs.")
        elif found["tls"]:
            print("This service uses an external certificate. Follow its issuer's trust instructions, then reopen "
                  "this exact URL in a new private window without a warning before entering the code.")
        return


if __name__ == "__main__":
    try:
        main()
    except (T.TransitionError, ValueError) as e:
        sys.exit(f"alt: {S.localized(str(e))}")
