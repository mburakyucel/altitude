#!/usr/bin/env python3
"""alt — the Altitude CLI. Thin: state operations go through the library under a lock; serving is `alt serve`."""
from __future__ import annotations
import argparse
import json
import os
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
from altitude import config, state as S, tasks as T  # noqa: E402

ACTOR = os.environ.get("ALTITUDE_ACTOR", "burak")
L2_COMMANDS = {("task", "status"), ("task", "show"), ("task", "events"), ("task", "messages"), ("task", "list"),
               ("task", "reply"), ("task", "block"), ("task", "done")}  # the door a worker may use


def _project(args) -> str:
    p = getattr(args, "project", None) or os.environ.get("ALTITUDE_PROJECT")
    if not p:
        sys.exit("alt: --project or ALTITUDE_PROJECT required")
    return p


def _stdin_or_file(args) -> str:
    if getattr(args, "file", None):
        return Path(args.file).read_text()
    if getattr(args, "text", None) and args.text != "-":
        return args.text
    return sys.stdin.read()


def out(obj) -> None:
    print(json.dumps(obj, indent=2, sort_keys=True, default=str) if not isinstance(obj, str) else obj)


def main(argv=None) -> None:
    ap = argparse.ArgumentParser(prog="alt")
    ap.add_argument("--project", "-p")
    sub = ap.add_subparsers(dest="cmd", required=True)
    sp = sub.add_parser("project"); ps = sp.add_subparsers(dest="pcmd", required=True)
    a = ps.add_parser("add"); a.add_argument("name"); a.add_argument("--path"); a.add_argument("--approval", default="default"); a.add_argument("--wip", type=int, default=config.WIP_PER_PROJECT)
    a.add_argument("--l2-engine", choices=config.ENGINES); a.add_argument("--l3-engine", choices=config.ENGINES)
    ps.add_parser("list"); ps.add_parser("discover")
    r = ps.add_parser("remove"); r.add_argument("name")
    sub.add_parser("state")
    t = sub.add_parser("task"); ts = t.add_subparsers(dest="tcmd", required=True)
    n = ts.add_parser("new"); n.add_argument("--title", required=True); n.add_argument("--hold-merge", metavar="WHY"); n.add_argument("--source", choices=("chat", "recovery"), default="chat"); n.add_argument("text", nargs="?", default="-"); n.add_argument("--file"); n.add_argument("--engine", choices=config.ENGINES, help="pin this L2; otherwise weekly quota routes it"); n.add_argument("--model", help="provider model override"); n.add_argument("--paths", help="comma-separated paths this task will touch")
    for name in ("reject", "block"):
        x = ts.add_parser(name); x.add_argument("slug"); x.add_argument("--reason", required=True)
        if name == "block":
            x.add_argument("--fault", action="store_true", help="the environment failed, not a decision: file the incident and tell L3")
            x.add_argument("--for-burak", action="store_true", help="the brief says to ask Burak here, or the call is plainly his: skip L3")
    es = ts.add_parser("escalate"); es.add_argument("slug"); es.add_argument("--question", required=True, help="one plain dilemma for Burak, with a recommendation")
    for name in ("show", "events", "messages"):
        x = ts.add_parser(name); x.add_argument("slug")
    x = ts.add_parser("status"); x.add_argument("slug", nargs="?")
    rs = ts.add_parser("resume", help="re-attach a blocked L2 with its transcript, worktree, and queued messages")
    rs.add_argument("slug")
    ms = ts.add_parser("message", help="queue a message for the task's L2; a blocked L2 resumes with it")
    ms.add_argument("slug"); ms.add_argument("text", nargs="?", default="-"); ms.add_argument("--file")
    st = ts.add_parser("stop", help="stop the task's L2 worker; the task blocks until resumed")
    st.add_argument("slug")
    tp = ts.add_parser("paths", help="set or repair a task's comma-separated file lease in any state")
    tp.add_argument("slug"); tp.add_argument("paths", metavar="a,b")
    hm = ts.add_parser("hold-merge", help="Burak merges this task's PRs himself (--why), or releases the hold (--off)")
    hm.add_argument("slug"); hm.add_argument("--why"); hm.add_argument("--off", action="store_true")
    dn = ts.add_parser("done"); dn.add_argument("slug"); dn.add_argument("--digest", default=""); dn.add_argument("--file")
    br = ts.add_parser("brief"); br.add_argument("slug"); br.add_argument("--file"); br.add_argument("text", nargs="?")
    rp = ts.add_parser("reply", help="current L2: append a human-readable reply to this task's conversation")
    rp.add_argument("text", nargs="?", default="-"); rp.add_argument("--file"); rp.add_argument("--slug")
    ls = ts.add_parser("list"); ls.add_argument("--all", action="store_true")

    f = sub.add_parser("fyi"); f.add_argument("slug", nargs="?"); f.add_argument("text")
    sub.add_parser("decisions"); sub.add_parser("agents"); sub.add_parser("digest"); sub.add_parser("monitor")
    dp = sub.add_parser("dispatch"); dp.add_argument("slug"); dp.add_argument("--model")
    vf = sub.add_parser("verify"); vf.add_argument("slug")
    pl = sub.add_parser("poll")
    ln = sub.add_parser("land"); ln.add_argument("--message", required=True, help="commit message; its first line is the default PR title"); ln.add_argument("--pr-title"); ln.add_argument("--pr-body-file"); ln.add_argument("--merge", action="store_true"); ln.add_argument("--wait", type=int, default=600, help="seconds to wait for PR checks (0 = report current state, don't wait)"); ln.add_argument("--paths", help="comma-separated lease override"); ln.add_argument("--base", default="main"); ln.add_argument("--test-cmd", default="make test", help="full local suite used only when the pinned PR pair configures no CI"); ln.add_argument("--dry-run", action="store_true")
    ch = sub.add_parser("chat"); ch.add_argument("text", nargs="?", default="-"); ch.add_argument("--trigger", default="chat"); ch.add_argument("--engine", choices=config.ENGINES, help="pin this turn to one engine")
    sub.add_parser("l3-reset")
    ic = sub.add_parser("incident"); ics = ic.add_subparsers(dest="icmd", required=True)
    inew = ics.add_parser("new"); inew.add_argument("--title", required=True); inew.add_argument("--task"); inew.add_argument("--what", required=True); inew.add_argument("--evidence", required=True); inew.add_argument("--cause", required=True); inew.add_argument("--tag", action="append", default=[])
    iam = ics.add_parser("amend"); iam.add_argument("id"); iam.add_argument("--what"); iam.add_argument("--evidence"); iam.add_argument("--cause"); iam.add_argument("--status", choices=["open", "watch", "closed"]); iam.add_argument("--reason", required=True)
    ics.add_parser("list")
    sv = sub.add_parser("serve"); sv.add_argument("--host"); sv.add_argument("--port", type=int)
    sub.add_parser("install-statusline")
    sub.add_parser("install-git-guards")
    ti = sub.add_parser("tls-init"); ti.add_argument("--ip")

    args = ap.parse_args(argv)
    config.ensure_root()
    c = args.cmd
    if ACTOR == "l2" and (c, getattr(args, "tcmd", None)) not in L2_COMMANDS and c not in ("land", "fyi", "incident"):
        sys.exit(f"alt {c}: not available to an L2 worker; use status, messages, reply, block, done, or land")
    if c == "project":
        P = config.load_projects()
        if args.pcmd == "add":
            path = Path(args.path or (config.PROJECT_ROOTS[0] / args.name)).expanduser()
            if not path.is_dir():
                sys.exit(f"alt: {path} is not a directory")
            P[args.name] = {"path": str(path), "approval": args.approval, "wip": args.wip,
                            **({"l2_engine": args.l2_engine} if args.l2_engine else {}),
                            **({"l3_engine": args.l3_engine} if args.l3_engine else {})}
            config.save_projects(P); config.project_dir(args.name).mkdir(parents=True, exist_ok=True); S.regen_state_md(args.name); out(P[args.name])
        elif args.pcmd == "remove":
            P.pop(args.name, None); config.save_projects(P); out("removed")
        elif args.pcmd == "discover":
            out(config.discover_projects())
        else:
            out(P)
        return
    if c == "state":
        print(S.regen_state_md(_project(args))); return
    if c == "task":
        p = _project(args); tc = args.tcmd
        if tc == "new":
            out(T.new(p, args.title, _stdin_or_file(args), actor=ACTOR, source=args.source, model=args.model, engine=args.engine, paths=(args.paths or "").split(",") if args.paths else None, hold_merge=args.hold_merge))
        elif tc == "reject":
            out(T.reject(p, args.slug, args.reason, actor=ACTOR))
        elif tc == "block":
            if ACTOR == "l2":
                attempt = os.environ.get("ALTITUDE_ATTEMPT")
                if args.slug != os.environ.get("ALTITUDE_TASK") or not attempt:
                    sys.exit("alt task block: an L2 blocks only its own task (ALTITUDE_TASK, ALTITUDE_ATTEMPT)")
                if args.fault:
                    if S.load_task(p, args.slug).get("attempt") != int(attempt):
                        sys.exit(f"alt task block: attempt {attempt} is no longer current")
                else:
                    waiting = "burak" if args.for_burak else "l3"
                    out(T.block(p, args.slug, args.reason, actor="l2", expected_state="running",
                                expected_attempt=int(attempt), updates={"waiting_on": waiting}))
                    if waiting == "l3":  # L3 answers from the record, or hands Burak one plain dilemma
                        from altitude import l3
                        l3.queue_message(p, T.block_question(args.slug, args.reason), trigger="block")
            elif not args.fault:
                out(T.block(p, args.slug, args.reason, actor=ACTOR, updates={"waiting_on": "burak"}))
            if args.fault:
                # An environment fault is Altitude's to fix, not a question for Burak: the same path as a fault
                # altd detects itself (block, one incident per kind per day, one message for L3).
                from altitude import incidents
                out(incidents.system_fault(f"worker:{args.slug}", args.reason, project=p, task=args.slug)
                    or {"state": "blocked", "note": "this fault was already filed today; L3 was told once"})
        elif tc == "resume":
            from altitude import dispatch
            out(dispatch.resume(p, args.slug))
        elif tc == "escalate":
            out(T.escalate(p, args.slug, args.question, actor=ACTOR))
        elif tc == "message":
            from altitude import dispatch
            message = T.message(p, args.slug, "l3" if ACTOR == "l3" else "burak", _stdin_or_file(args), by=ACTOR)
            if S.load_task(p, args.slug).get("state") == "blocked":
                dispatch.resume(p, args.slug)
            out(message)
        elif tc == "stop":
            from altitude import dispatch
            out(dispatch.stop(p, args.slug, by=ACTOR))
        elif tc == "paths":
            declared = [x.strip() for x in args.paths.split(",") if x.strip()]
            if not declared:
                sys.exit("alt task paths: no paths named")
            with S.project_lock(p):
                task = S.load_task(p, args.slug)
                previous = task.get("paths") or []
                task["paths"] = declared
                S.save_task(p, task)
                S.append_event(p, args.slug, "paths", by=ACTOR, previous=previous, paths=declared)
            S.regen_state_md(p)
            out(task)
        elif tc == "hold-merge":
            if not args.off and not args.why:
                sys.exit("alt task hold-merge: --why <reason> (or --off)")
            out(T.set_hold_merge(p, args.slug, None if args.off else args.why, actor=ACTOR))
        elif tc == "done":
            if ACTOR == "l2" and not os.environ.get("ALTITUDE_ATTEMPT"):
                sys.exit("alt task done: ALTITUDE_ATTEMPT is required for the L2")
            out(T.done(p, args.slug, actor=ACTOR, digest=Path(args.file).read_text() if args.file else args.digest,
                       expected_attempt=int(os.environ["ALTITUDE_ATTEMPT"]) if ACTOR == "l2" else None))
        elif tc == "brief":
            out(str(T.brief(p, args.slug, _stdin_or_file(args), actor=ACTOR)))
        elif tc == "reply":
            if ACTOR != "l2":
                sys.exit("alt task reply: only the current L2 may use this command")
            slug = args.slug or os.environ.get("ALTITUDE_TASK")
            attempt = os.environ.get("ALTITUDE_ATTEMPT")
            if not slug or not attempt:
                sys.exit("alt task reply: ALTITUDE_TASK and ALTITUDE_ATTEMPT are required")
            out(T.message(p, slug, "l2", _stdin_or_file(args), by="l2", expected_attempt=int(attempt)))
        elif tc == "show":
            out(S.load_task(p, args.slug))
        elif tc == "status":
            from altitude import status
            slug = args.slug or os.environ.get("ALTITUDE_TASK")
            if not slug:
                sys.exit("alt task status: slug or ALTITUDE_TASK required")
            out(status.status(p, slug))
        elif tc == "events":
            out(S.read_events(p, args.slug))
        elif tc == "messages":
            out(T.task_messages(p, args.slug))
        elif tc == "list":
            out([{k: t.get(k) for k in ("slug", "state", "title", "attempt", "updated")} for t in S.list_tasks(p, include_archive=args.all)])
        return
    if c == "fyi":
        out(T.fyi(_project(args), args.slug, args.text, actor=ACTOR)); return
    if c == "decisions":
        from altitude import digest; out(digest.queue()); return
    if c == "digest":
        from altitude import digest; print(digest.text()); return
    if c == "agents":
        from altitude import engines; out(engines.claude_agents()); return
    if c == "monitor":
        from altitude import monitor; out({"quota": monitor.quota(), "sessions": monitor.sessions()}); return
    if c == "dispatch":
        from altitude import dispatch; out(dispatch.run(_project(args), args.slug, model=args.model)); return
    if c == "verify":
        from altitude import verify; out(verify.verify(_project(args), args.slug)); return
    if c == "poll":
        from altitude import dispatch; out(dispatch.poll(_project(args))); return
    if c == "land":
        from altitude import land
        try:
            out(land.land(args.message, project=args.project, pr_title=args.pr_title, pr_body_file=args.pr_body_file,
                          merge=args.merge, wait=args.wait, paths=args.paths, base=args.base,
                          test_cmd=args.test_cmd, dry_run=args.dry_run))
        except land.EmptyLeaseError as e:
            sys.exit(str(e))
        except land.LandError as e:
            sys.exit(f"alt land: {e}")
        return
    if c == "chat":
        from altitude import l3
        res = l3.turn(_project(args), _stdin_or_file(args), trigger=args.trigger, engine=args.engine, on_text=lambda t: (sys.stdout.write(t), sys.stdout.flush()))
        print(); out({k: res.get(k) for k in ("session_id", "context_percent", "turns", "cost", "error", "engine")}); return
    if c == "l3-reset":
        from altitude import l3; l3.reset(_project(args)); out("L3 will start fresh on the next turn"); return
    if c == "incident":
        from altitude import incidents; p = _project(args)
        if args.icmd == "new":
            out(incidents.new_incident(p, title=args.title, task=args.task, what=args.what, evidence=args.evidence, cause=args.cause,
                                     tags=args.tag, actor=ACTOR))
        elif args.icmd == "amend":
            fields = {k: v for k, v in (("what", args.what), ("evidence", args.evidence), ("cause", args.cause), ("status", args.status)) if v is not None}
            try:
                out(incidents.amend_incident(p, args.id, reason=args.reason, actor=ACTOR, **fields))
            except ValueError as e:
                sys.exit(f"alt: {e}")
        else:
            out([r for r in incidents.index() if r["project"] == p])
        return
    if c == "serve":
        from altitude import server; server.main(host=args.host, port=args.port); return
    if c == "install-statusline":
        from altitude import server; out(server.install_statusline()); return
    if c == "install-git-guards":
        from altitude import git_policy
        try:
            hooks_path = git_policy.install_hooks(Path.cwd())
        except git_policy.GitPolicyError as e:
            sys.exit(f"alt install-git-guards: {e}")
        out({"ok": True, "hooks_path": str(hooks_path)})
        return
    if c == "tls-init":
        from altitude import server; out(server.tls_init(args.ip)); return


if __name__ == "__main__":
    try:
        main()
    except T.TransitionError as e:
        sys.exit(f"alt: {e}")
