#!/usr/bin/env python3
"""alt — the Altitude CLI. Thin: state operations go through the library under a lock; serving is `alt serve`."""
from __future__ import annotations
import argparse
import hashlib
import importlib.abc
import importlib.util
import json
import os
import sys
from pathlib import Path

# Evidence readers and the startup capture must not create bytecode in an inspected checkout.
if {"manifest", "preflight", "serve"} & set(sys.argv[1:]):
    sys.dont_write_bytecode = True
_REPO = Path(__file__).resolve().parent.parent


def _early_runtime_source(repo: Path) -> tuple[dict, dict[str, bytes]]:
    """Capture runtime identities and the exact Python bytes that this process will execute."""
    build = ("web/design/tokens.css", "web/index.html", "web/package.json", "web/tsconfig.json",
             "web/vite.config.ts", "systemd/altitude.service", "Makefile")
    files = list((repo / "altitude").rglob("*.py"))
    files += [repo / relative for relative in ("bin/alt", "scripts/restart_altitude.py", *build)]
    for directory in ("personas", "schemas", "templates", "hooks"):
        root = repo / directory
        files += [path for path in root.rglob("*")
                  if (path.is_file() or path.is_symlink()) and "__pycache__" not in path.parts]
    web = repo / "web" / "src"
    files += [path for path in web.rglob("*") if (path.is_file() or path.is_symlink())
              and path.suffix in (".ts", ".tsx", ".css") and ".test." not in path.name
              and "test" not in path.relative_to(web).parts and path.name != "vitest.setup.ts"]
    rows, python_sources = [], {}
    for path in sorted(set(files), key=lambda item: item.relative_to(repo).as_posix()):
        if not path.is_file() and not path.is_symlink():
            continue
        stat = path.lstat()
        link = os.readlink(path) if path.is_symlink() else None
        relative = path.relative_to(repo).as_posix()
        if link is not None and relative.startswith("altitude/") and relative.endswith(".py"):
            raise RuntimeError(
                f"refusing executable Python runtime symlink before import: {relative}")
        data = os.fsencode(link) if link is not None else path.read_bytes()
        if link is None and relative.startswith("altitude/") and relative.endswith(".py"):
            python_sources[relative] = data
        mode = "120000" if link is not None else "100755" if stat.st_mode & 0o111 else "100644"
        rows.append({"path": relative, "mode": mode,
                     "sha256": hashlib.sha256(data).hexdigest(),
                     "stat": [stat.st_dev, stat.st_ino, stat.st_size,
                              stat.st_mtime_ns, stat.st_ctime_ns]})
    encoded = json.dumps(rows, sort_keys=True, separators=(",", ":"), ensure_ascii=True).encode()
    return ({"root": str(repo.resolve()), "files": rows,
             "sha256": hashlib.sha256(encoded).hexdigest()}, python_sources)


class _CapturedAltitudeImporter(importlib.abc.MetaPathFinder, importlib.abc.Loader):
    """Load only captured ``altitude/*.py`` bytes, bypassing all timestamp-based pyc caches."""

    def __init__(self, repo: Path, sources: dict[str, bytes]):
        self.repo, self.sources = repo, sources

    @staticmethod
    def _relative(fullname: str) -> str:
        suffix = "/".join(fullname.removeprefix("altitude").split("."))
        return "altitude/__init__.py" if not suffix else f"altitude{suffix}.py"

    def find_spec(self, fullname, path=None, target=None):
        relative = self._relative(fullname)
        if ((fullname != "altitude" and not fullname.startswith("altitude."))
                or relative not in self.sources):
            return None
        return importlib.util.spec_from_loader(fullname, self, is_package=fullname == "altitude")

    def create_module(self, spec):
        return None

    def exec_module(self, module) -> None:
        relative = self._relative(module.__name__)
        filename = str(self.repo / relative)
        module.__file__ = filename
        if module.__name__ == "altitude":
            module.__path__ = [str(self.repo / "altitude")]
        exec(compile(self.sources[relative], filename, "exec", dont_inherit=True), module.__dict__)


if ("serve" in sys.argv[1:] or
        ({"manifest", "preflight"} & set(sys.argv[1:]) and "running_install" in sys.argv[1:])):
    _STARTUP_SOURCE, _STARTUP_PYTHON = _early_runtime_source(_REPO)
    sys.meta_path.insert(0, _CapturedAltitudeImporter(_REPO, _STARTUP_PYTHON))
else:
    _STARTUP_SOURCE = None
sys.path.insert(0, str(_REPO))
from altitude import config  # noqa: E402

ACTOR = os.environ.get("ALTITUDE_ACTOR", "burak")


def _project(args) -> str:
    p = getattr(args, "project", None) or os.environ.get("ALTITUDE_PROJECT")
    if not p:
        sys.exit("alt: --project or ALTITUDE_PROJECT required")
    return p


def _stdin_or_file(args) -> str:
    if getattr(args, "file", None):
        return Path(args.file).read_text()
    if getattr(args, "text", None) and args.text != "-":
        return args.text
    return sys.stdin.read()


def out(obj) -> None:
    print(json.dumps(obj, indent=2, sort_keys=True, default=str) if not isinstance(obj, str) else obj)


def _read_evidence(path: Path | None) -> dict | None:
    if path is None:
        return None
    try:
        value = json.loads(path.read_bytes())
    except (OSError, UnicodeDecodeError, ValueError) as exc:
        sys.exit(f"alt: cannot read evidence {path}: {exc}")
    if not isinstance(value, dict):
        sys.exit(f"alt: evidence {path} is not a JSON object")
    return value


def _read_evidence_bytes(path: Path | None) -> bytes | None:
    if path is None:
        return None
    try:
        return path.read_bytes()
    except OSError as exc:
        sys.exit(f"alt: cannot read raw evidence {path}: {exc}")


def main(argv=None) -> None:
    ap = argparse.ArgumentParser(prog="alt")
    ap.add_argument("--project", "-p")
    sub = ap.add_subparsers(dest="cmd", required=True)
    l1p = sub.add_parser("l1", help="optional L1 runs on an enabled engine: run / wait / status"); l1s = l1p.add_subparsers(dest="lcmd", required=True)
    lr = l1s.add_parser("run"); lr.add_argument("--brief", required=True); lr.add_argument("--role", default="implementer", choices=("implementer", "reviewer"))
    lr.add_argument("--engine", choices=config.AUTONOMOUS_ENGINES); lr.add_argument("--model"); lr.add_argument("--name"); lr.add_argument("--cwd")
    lr.add_argument("--paths", help="comma-separated sublease within the owning task lease")
    lw = l1s.add_parser("wait"); lw.add_argument("name", nargs="?"); lw.add_argument("--timeout", type=int, default=540)
    l1s.add_parser("status")
    lx = l1s.add_parser("_exec"); lx.add_argument("slug"); lx.add_argument("name")

    sp = sub.add_parser("project"); ps = sp.add_subparsers(dest="pcmd", required=True)
    a = ps.add_parser("add"); a.add_argument("name"); a.add_argument("--path"); a.add_argument("--approval", default="default"); a.add_argument("--wip", type=int, default=config.WIP_PER_PROJECT)
    a.add_argument("--l2-engine", choices=config.AUTONOMOUS_ENGINES); a.add_argument("--l3-engine", choices=config.AUTONOMOUS_ENGINES)
    ps.add_parser("list"); ps.add_parser("discover")
    r = ps.add_parser("remove"); r.add_argument("name")

    sub.add_parser("state")
    t = sub.add_parser("task"); ts = t.add_subparsers(dest="tcmd", required=True)
    n = ts.add_parser("new"); n.add_argument("--title", required=True); n.add_argument("--hold-merge", metavar="WHY"); n.add_argument("--source", choices=("chat", "recovery"), default="chat"); n.add_argument("text", nargs="?", default="-"); n.add_argument("--file"); n.add_argument("--engine", choices=config.AUTONOMOUS_ENGINES, help="pin this L2; otherwise weekly quota routes it"); n.add_argument("--model", help="provider model override"); n.add_argument("--paths", help="comma-separated paths this task will touch")
    for name in ("reject", "block"):
        x = ts.add_parser(name); x.add_argument("slug"); x.add_argument("--reason", required=True)
    for name in ("show", "events", "messages"):
        x = ts.add_parser(name); x.add_argument("slug")
    x = ts.add_parser("status"); x.add_argument("slug", nargs="?")
    rs = ts.add_parser("resume", help="re-attach a blocked L2 with its transcript and worktree")
    rs.add_argument("slug")
    rs.add_argument("--answer", default="", help="what the L2 reads first; one sentence with the missing step or answer")
    tp = ts.add_parser("paths", help="set or repair a task's comma-separated file lease in any state")
    tp.add_argument("slug"); tp.add_argument("paths", metavar="a,b")
    hm = ts.add_parser("hold-merge", help="Burak merges this task's PRs himself (--why), or releases the hold (--off)")
    hm.add_argument("slug"); hm.add_argument("--why"); hm.add_argument("--off", action="store_true")
    dn = ts.add_parser("done"); dn.add_argument("slug"); dn.add_argument("--digest", default=""); dn.add_argument("--file")
    br = ts.add_parser("brief"); br.add_argument("slug"); br.add_argument("--file"); br.add_argument("text", nargs="?")
    rp = ts.add_parser("reply", help="current L2: append a human-readable reply to this task's conversation")
    rp.add_argument("text", nargs="?", default="-"); rp.add_argument("--file"); rp.add_argument("--slug")
    ls = ts.add_parser("list"); ls.add_argument("--all", action="store_true")

    f = sub.add_parser("fyi"); f.add_argument("slug", nargs="?"); f.add_argument("text")
    sub.add_parser("decisions"); sub.add_parser("agents"); sub.add_parser("digest"); sub.add_parser("monitor")
    dp = sub.add_parser("dispatch"); dp.add_argument("slug"); dp.add_argument("--model")
    vf = sub.add_parser("verify"); vf.add_argument("slug")
    pl = sub.add_parser("poll")
    tr = sub.add_parser("transcript", help="export or validate a portable private transcript bundle")
    trs = tr.add_subparsers(dest="transcript_cmd", required=True)
    tre = trs.add_parser("export"); tre.add_argument("slug"); tre.add_argument("destination", type=Path); tre.add_argument("--attempt")
    trv = trs.add_parser("validate"); trv.add_argument("bundle", type=Path)
    ln = sub.add_parser("land"); ln.add_argument("--message", required=True, help="commit message; its first line is the default PR title"); ln.add_argument("--pr-title"); ln.add_argument("--pr-body-file"); ln.add_argument("--merge", action="store_true"); ln.add_argument("--wait", type=int, default=600, help="seconds to wait for PR checks (0 = report current state, don't wait)"); ln.add_argument("--paths", help="comma-separated lease override"); ln.add_argument("--base", default="main"); ln.add_argument("--test-cmd", default="make test", help="full local suite used only when the pinned PR pair configures no CI"); ln.add_argument("--dry-run", action="store_true")
    ch = sub.add_parser("chat"); ch.add_argument("text", nargs="?", default="-"); ch.add_argument("--trigger", default="chat")
    sub.add_parser("l3-reset")
    ic = sub.add_parser("incident"); ics = ic.add_subparsers(dest="icmd", required=True)
    inew = ics.add_parser("new"); inew.add_argument("--title", required=True); inew.add_argument("--task"); inew.add_argument("--what", required=True); inew.add_argument("--evidence", required=True); inew.add_argument("--cause", required=True); inew.add_argument("--tag", action="append", default=[])
    iam = ics.add_parser("amend"); iam.add_argument("id"); iam.add_argument("--what"); iam.add_argument("--evidence"); iam.add_argument("--cause"); iam.add_argument("--status", choices=["open", "watch", "closed"]); iam.add_argument("--reason", required=True)
    ics.add_parser("list")
    rc = sub.add_parser("recovery"); rcs = rc.add_subparsers(dest="recovery_cmd", required=True)
    rcs.add_parser("status")
    rh = rcs.add_parser("hold"); rh.add_argument("--reason", required=True)
    rr = rcs.add_parser("clear"); rr.add_argument("--reason", required=True)
    mf = sub.add_parser("manifest", help="print one strict read-only install/candidate manifest")
    pf = sub.add_parser("preflight", help="read-only inventory of a copied ALTITUDE_HOME")
    pf.add_argument("--home", type=Path, required=True, help="path to the offline copied state home")
    for reader in (mf, pf):
        reader.add_argument("--role", required=True,
                            choices=("running_install", "stopped_install", "detached_candidate"))
        reader.add_argument("--repo", type=Path, help="checkout to inspect; B is still derived from ExecStart")
        reader.add_argument("--inventory-repo", type=Path,
                            help="preflight source roster checkout when it differs from inspected B")
        reader.add_argument("--provider-home", type=Path,
                            help="explicit home containing copied/read-only provider job evidence")
        reader.add_argument("--candidate-sha", help="required full commit SHA for detached_candidate")
        reader.add_argument("--prior-receipt", type=Path,
                            help="immutable running/bootstrap prior receipt for stopped_install")
        reader.add_argument("--bootstrap-evidence", type=Path,
                            help="one-time bootstrap declaration for first stopped activation")
        reader.add_argument("--bootstrap-raw-evidence", type=Path,
                            help="exact prerequisite freeze/provenance evidence bytes")
    sv = sub.add_parser("serve"); sv.add_argument("--host"); sv.add_argument("--port", type=int)
    sub.add_parser("install-statusline")
    sub.add_parser("install-git-guards")
    ti = sub.add_parser("tls-init"); ti.add_argument("--ip")

    args = ap.parse_args(argv)
    c = args.cmd
    # These two commands are evidence readers.  In particular, do not call ensure_root before an
    # offline preflight: even a missing input must remain missing.
    if c == "manifest":
        from altitude import manifest
        result = manifest.runtime_manifest(
            role=args.role, repo=args.repo, expected_commit=args.candidate_sha,
            prior_receipt=_read_evidence(args.prior_receipt),
            bootstrap_evidence=_read_evidence(args.bootstrap_evidence),
            bootstrap_raw_evidence=_read_evidence_bytes(args.bootstrap_raw_evidence),
            startup_source=_STARTUP_SOURCE, loaded_modules=manifest.loaded_module_origins())
        out(result)
        if not result["valid"]:
            raise SystemExit(2)
        return
    if c == "preflight":
        from altitude import legacy_preflight
        result = legacy_preflight.offline_preflight(
            args.home, repo=args.repo, manifest_role=args.role,
            inventory_repo=args.inventory_repo, provider_home=args.provider_home,
            expected_commit=args.candidate_sha,
            prior_receipt=_read_evidence(args.prior_receipt),
            bootstrap_evidence=_read_evidence(args.bootstrap_evidence),
            bootstrap_raw_evidence=_read_evidence_bytes(args.bootstrap_raw_evidence),
            startup_source=_STARTUP_SOURCE,
            loaded_modules=legacy_preflight.runtime_identity.loaded_module_origins())
        out(result)
        if result["cutover_blocked"]:
            raise SystemExit(2)
        return
    from altitude import state as S, tasks as T
    config.ensure_root()
    if c == "l1":
        from altitude import l1 as L1
        p = _project(args)
        slug = getattr(args, "slug", None) or os.environ.get("ALTITUDE_TASK")
        if not slug:
            sys.exit("alt l1: ALTITUDE_TASK required (every L2 session has it)")
        if args.lcmd == "run":
            if ACTOR != "l2":
                sys.exit("alt l1 run: only the current L2 may launch task helpers")
            dispatch_id = os.environ.get("ALTITUDE_DISPATCH_ID")
            l2_token = os.environ.get("ALTITUDE_L2_TOKEN") or os.environ.get("ALTITUDE_L2_CAPABILITY")
            if not dispatch_id or not l2_token:
                sys.exit("alt l1 run: ALTITUDE_DISPATCH_ID and the L2 capability are required")
            out(L1.start(p, slug, Path(args.brief), role=args.role, engine=args.engine, model=args.model,
                         name=args.name, cwd=args.cwd,
                         paths=[path.strip() for path in (args.paths or "").split(",") if path.strip()] or None,
                         expected_dispatch_id=dispatch_id,
                         expected_l2_token=l2_token))
        elif args.lcmd == "wait":
            out(L1.wait(p, slug, args.name, timeout=args.timeout))
        elif args.lcmd == "status":
            out(L1.status(p, slug))
        elif args.lcmd == "_exec":
            out(L1.exec_run(p, slug, args.name))
        return
    if c == "project":
        P = config.load_projects()
        if args.pcmd == "add":
            path = Path(args.path or (config.PROJECT_ROOTS[0] / args.name)).expanduser()
            if not path.is_dir():
                sys.exit(f"alt: {path} is not a directory")
            P[args.name] = {"path": str(path), "approval": args.approval, "wip": args.wip,
                            **({"l2_engine": args.l2_engine} if args.l2_engine else {}),
                            **({"l3_engine": args.l3_engine} if args.l3_engine else {})}
            config.save_projects(P); config.project_dir(args.name).mkdir(parents=True, exist_ok=True); S.regen_state_md(args.name); out(P[args.name])
        elif args.pcmd == "remove":
            P.pop(args.name, None); config.save_projects(P); out("removed")
        elif args.pcmd == "discover":
            out(config.discover_projects())
        else:
            out(P)
        return
    if c == "state":
        print(S.regen_state_md(_project(args))); return
    if c == "task":
        p = _project(args); tc = args.tcmd
        if tc == "new":
            out(T.new(p, args.title, _stdin_or_file(args), actor=ACTOR, source=args.source, model=args.model, engine=args.engine, paths=(args.paths or "").split(",") if args.paths else None, hold_merge=args.hold_merge))
        elif tc == "reject":
            out(T.reject(p, args.slug, args.reason, actor=ACTOR))
        elif tc == "block":
            out(T.block(p, args.slug, args.reason, actor=ACTOR))
        elif tc == "resume":
            t = S.load_task(p, args.slug)
            T.require_owner_provider_capability(t)
            if t["state"] == "blocked" and t.get("session_id"):
                answer = args.answer or "Continue from your progress file; finish to *done* and rewrite the report."
                from altitude import dispatch
                res = dispatch.resume_blocked(p, args.slug, answer, prefix="Altitude: ")
                resumed = S.load_task(p, args.slug)
                if res.get("deferred"):
                    out({"slug": args.slug, "state": "blocked", "deferred": True,
                         "waiting": res.get("waiting") or res.get("hold") or resumed.get("blocked_reason")})
                else:
                    out({"slug": args.slug, "state": "running", "deferred": False,
                         "agent": (res.get("agent") or {}).get("id")})
            else:
                out(T.resume(p, args.slug, actor=ACTOR))
        elif tc == "paths":
            declared = [x.strip() for x in args.paths.split(",") if x.strip()]
            if not declared:
                sys.exit("alt task paths: no paths named")
            with S.project_lock(p):
                task = S.load_task(p, args.slug)
                T.require_owner_provider_capability(task)
                previous = task.get("paths") or []
                task["paths"] = declared
                S.save_task(p, task)
                S.append_event(p, args.slug, "paths", by=ACTOR, previous=previous, paths=declared)
            S.regen_state_md(p)
            out(task)
        elif tc == "hold-merge":
            if not args.off and not args.why:
                sys.exit("alt task hold-merge: --why <reason> (or --off)")
            out(T.set_hold_merge(p, args.slug, None if args.off else args.why, actor=ACTOR))
        elif tc == "done":
            out(T.done(p, args.slug, actor=ACTOR, digest=Path(args.file).read_text() if args.file else args.digest,
                       expected_dispatch_id=os.environ.get("ALTITUDE_DISPATCH_ID") if ACTOR == "l2" else None,
                       expected_l2_token=(os.environ.get("ALTITUDE_L2_TOKEN") or
                                          os.environ.get("ALTITUDE_L2_CAPABILITY")) if ACTOR == "l2" else None))
        elif tc == "brief":
            out(str(T.brief(p, args.slug, _stdin_or_file(args), actor=ACTOR)))
        elif tc == "reply":
            if ACTOR != "l2":
                sys.exit("alt task reply: only the current L2 may use this command")
            slug = args.slug or os.environ.get("ALTITUDE_TASK")
            dispatch_id = os.environ.get("ALTITUDE_DISPATCH_ID")
            l2_token = os.environ.get("ALTITUDE_L2_TOKEN") or os.environ.get("ALTITUDE_L2_CAPABILITY")
            if not slug or not dispatch_id or not l2_token:
                sys.exit("alt task reply: ALTITUDE_TASK, ALTITUDE_DISPATCH_ID, and the L2 capability are required")
            out(T.append_task_message(p, slug, "l2", _stdin_or_file(args),
                                      expected_dispatch_id=dispatch_id, expected_l2_token=l2_token, actor="l2"))
        elif tc == "show":
            out(S.load_task(p, args.slug))
        elif tc == "status":
            from altitude import status
            slug = args.slug or os.environ.get("ALTITUDE_TASK")
            if not slug:
                sys.exit("alt task status: slug or ALTITUDE_TASK required")
            out(status.status(p, slug))
        elif tc == "events":
            out(S.read_events(p, args.slug))
        elif tc == "messages":
            out(T.task_messages(p, args.slug))
        elif tc == "list":
            out([{k: t.get(k) for k in ("slug", "state", "title", "dispatch_id", "updated")} for t in S.list_tasks(p, include_archive=args.all)])
        return
    if c == "fyi":
        out(T.fyi(_project(args), args.slug, args.text, actor=ACTOR)); return
    if c == "decisions":
        from altitude import digest; out(digest.queue()); return
    if c == "digest":
        from altitude import digest; print(digest.text()); return
    if c == "agents":
        from altitude import engines; out(engines.claude_agents()); return
    if c == "monitor":
        from altitude import monitor; out({"quota": monitor.quota(), "sessions": monitor.sessions()}); return
    if c == "dispatch":
        from altitude import dispatch; out(dispatch.run(_project(args), args.slug, model=args.model)); return
    if c == "verify":
        from altitude import verify; out(verify.verify(_project(args), args.slug)); return
    if c == "poll":
        from altitude import dispatch; out(dispatch.poll(_project(args))); return
    if c == "transcript":
        from altitude import transcript
        if args.transcript_cmd == "export":
            out(str(transcript.export(_project(args), args.slug, args.destination, args.attempt)))
        else:
            out(transcript.validate_bundle(args.bundle))
        return
    if c == "land":
        from altitude import land
        try:
            out(land.land(args.message, project=args.project, pr_title=args.pr_title, pr_body_file=args.pr_body_file,
                          merge=args.merge, wait=args.wait, paths=args.paths, base=args.base,
                          test_cmd=args.test_cmd, dry_run=args.dry_run))
        except land.EmptyLeaseError as e:
            sys.exit(str(e))
        except land.LandError as e:
            sys.exit(f"alt land: {e}")
        return
    if c == "chat":
        sys.exit("alt chat: direct L3 execution is disabled; use the running service chat API")
    if c == "l3-reset":
        sys.exit("alt l3-reset: direct L3 mutation is disabled; use the running service")
    if c == "incident":
        from altitude import incidents; p = _project(args)
        if args.icmd == "new":
            out(incidents.new_incident(p, title=args.title, task=args.task, what=args.what, evidence=args.evidence, cause=args.cause,
                                     tags=args.tag, actor=ACTOR))
        elif args.icmd == "amend":
            fields = {k: v for k, v in (("what", args.what), ("evidence", args.evidence), ("cause", args.cause), ("status", args.status)) if v is not None}
            try:
                out(incidents.amend_incident(p, args.id, reason=args.reason, actor=ACTOR, **fields))
            except ValueError as e:
                sys.exit(f"alt: {e}")
        else:
            out([r for r in incidents.index() if r["project"] == p])
        return
    if c == "recovery":
        from altitude import recovery
        if args.recovery_cmd == "hold":
            out(recovery.hold(args.reason, actor=ACTOR))
        elif args.recovery_cmd == "clear":
            try:
                out(recovery.clear(args.reason, actor=ACTOR))
            except ValueError as e:
                sys.exit(f"alt: {e}")
        else:
            out(recovery.status() or {"active": False})
        return
    if c == "serve":
        from altitude import server
        server.main(host=args.host, port=args.port, startup_source=_STARTUP_SOURCE)
        return
    if c == "install-statusline":
        from altitude import server; out(server.install_statusline()); return
    if c == "install-git-guards":
        from altitude import git_policy
        try:
            hooks_path = git_policy.install_hooks(Path.cwd())
        except git_policy.GitPolicyError as e:
            sys.exit(f"alt install-git-guards: {e}")
        out({"ok": True, "hooks_path": str(hooks_path)})
        return
    if c == "tls-init":
        from altitude import server; out(server.tls_init(args.ip)); return


if __name__ == "__main__":
    main()
