#!/usr/bin/python3
"""Guard the distribution OCI runtime's system-bus fallback; see altitude.platform."""
import sys
from pathlib import Path

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
from altitude import platform

try:
    raise SystemExit(platform.container_oci(sys.argv[1:]))
except Exception as exc:
    print(f"{platform.CONTAINER_BUS_DENIAL}: adapter failed: {exc}", file=sys.stderr)
    raise SystemExit(125)
