+use super::*;
+use pretty_assertions::assert_eq;
+use std::collections::HashMap;
+use std::collections::VecDeque;
+
+// Evaluate the emitted write alternatives, rather than the preparation's
+// intermediate root lists. This is deterministic generation evidence only.
+#[derive(Debug)]
+enum Expr {
+    Atom(String),
+    List(Vec<Expr>),
+}
+
+impl Expr {
+    fn parse(tokens: &mut VecDeque<String>) -> Self {
+        let token = tokens.pop_front().expect("policy token");
+        if token != "(" {
+            return Self::Atom(token);
+        }
+        let mut children = Vec::new();
+        while tokens.front().expect("closing parenthesis") != ")" {
+            children.push(Self::parse(tokens));
+        }
+        tokens.pop_front();
+        Self::List(children)
+    }
+
+    fn atom(&self) -> &str {
+        match self {
+            Self::Atom(value) => value,
+            Self::List(_) => panic!("expected atom: {self:?}"),
+        }
+    }
+
+    fn matches(&self, path: &Path, params: &HashMap<&str, &str>) -> bool {
+        let Self::List(parts) = self else {
+            panic!("expected predicate: {self:?}");
+        };
+        match parts[0].atom() {
+            "allow" => parts[1..]
+                .iter()
+                .filter(|part| matches!(part, Self::List(_)))
+                .any(|part| part.matches(path, params)),
+            "require-all" => parts[1..].iter().all(|part| part.matches(path, params)),
+            "require-not" => !parts[1].matches(path, params),
+            "literal" | "path" | "subpath" => {
+                let value = match &parts[1] {
+                    Self::Atom(value) => value.trim_matches('"'),
+                    Self::List(parameter) => {
+                        assert_eq!(parameter[0].atom(), "param");
+                        params[parameter[1].atom().trim_matches('"')]
+                    }
+                };
+                let root = Path::new(value);
+                if parts[0].atom() != "subpath" {
+                    path == root
+                } else {
+                    path.starts_with(root)
+                }
+            }
+            "regex" => {
+                let pattern = parts[1]
+                    .atom()
+                    .trim_start_matches('#')
+                    .trim_matches('"')
+                    .replace("\\\"", "\"");
+                regex_lite::Regex::new(&pattern)
+                    .expect("valid emitted regex")
+                    .is_match(&path.to_string_lossy())
+            }
+            // Conservatively admit these non-path constraints. A path denial
+            // must hold without relying on extensions or fictional vnode type.
+            "extension" | "vnode-type" => true,
+            other => panic!("unsupported write predicate: {other}"),
+        }
+    }
+}
+
+fn emitted_write_allows(args: &[String], path: &Path) -> bool {
+    let policy = seatbelt_policy_arg(args);
+    let lexer = regex_lite::Regex::new(r##";[^\n]*|#?"(?:\\.|[^"\\])*"|[()]|[^\s()]+"##)
+        .expect("policy lexer");
+    let mut tokens = lexer
+        .find_iter(policy)
+        .filter(|token| !token.as_str().starts_with(';'))
+        .map(|token| token.as_str().to_string())
+        .collect::<VecDeque<_>>();
+    let params = args
+        .iter()
+        .filter_map(|arg| arg.strip_prefix("-D")?.split_once('='))
+        .collect();
+    let mut allowed = false;
+    while !tokens.is_empty() {
+        let expression = Expr::parse(&mut tokens);
+        if let Expr::List(parts) = &expression
+            && parts
+                .first()
+                .is_some_and(|part| matches!(part, Expr::Atom(action) if action == "allow"))
+            && parts
+                .iter()
+                .any(|part| matches!(part, Expr::Atom(action) if action.starts_with("file-write")))
+        {
+            allowed |= expression.matches(path, &params);
+        }
+    }
+    allowed
+}
+
+fn metadata_args(
+    policy: &FileSystemSandboxPolicy,
+    cwd: &Path,
+    profile: MacosSeatbeltProfile,
+    trusted_home: Option<&AbsolutePathBuf>,
+) -> Vec<String> {
+    create_seatbelt_command_args_with_profile(
+        CreateSeatbeltCommandArgsParams {
+            command: vec!["/usr/bin/true".to_string()],
+            file_system_sandbox_policy: policy,
+            network_sandbox_policy: NetworkSandboxPolicy::Restricted,
+            sandbox_policy_cwd: cwd,
+            enforce_managed_network: false,
+            managed_network: None,
+            environment_id: None,
+            network: None,
+            extra_allow_unix_sockets: &[],
+        },
+        profile,
+        trusted_home,
+    )
+    .expect("prepare metadata policy")
+}
