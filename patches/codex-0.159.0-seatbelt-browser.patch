+    std::os::unix::fs::symlink(&physical, &home).expect("trusted home alias");
+    let policy = restricted_write_policy(&[&home, &child]);
+    let trusted = AbsolutePathBuf::from_absolute_path(&home).expect("absolute home");
+    let args = metadata_args(&policy, &cwd, MacosSeatbeltProfile::Process, Some(&trusted));
+    assert!(!emitted_write_allows(
+        &args,
+        &child.join(".agents/settings")
+    ));
+    assert!(emitted_write_allows(&args, &child.join("ordinary")));
+}
