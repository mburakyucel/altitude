+#[test]
+fn explicit_metadata_and_deeper_write_grants_keep_public_semantics() {
+    let tmp = TempDir::new().expect("tempdir");
+    let cwd = tmp.path().canonicalize().expect("canonical tempdir");
+    let parent = cwd.join("parent");
+    let child = parent.join("child");
+    let metadata = child.join(".agents");
+    let allowed = metadata.join("allowed");
+    fs::create_dir_all(&allowed).expect("fixture roots");
+    for explicit in [&metadata, &allowed] {
+        let policy = restricted_write_policy(&[&parent, &child, explicit]);
+        let args = metadata_args(
+            &policy,
+            &cwd,
+            MacosSeatbeltProfile::Process,
+            /*trusted_home*/ None,
+        );
+        for (target, permitted) in [
+            (explicit.join("settings"), true),
+            (explicit.join(".codex"), true),
+            (child.join(".codex"), false),
+        ] {
+            assert_eq!(
+                policy.can_write_local_path_with_cwd(&target, &cwd),
+                permitted
+            );
+            assert_eq!(emitted_write_allows(&args, &target), permitted);
+        }
+        let forbidden = metadata.join("outside");
+        assert_eq!(
+            emitted_write_allows(&args, &forbidden),
+            explicit == &metadata
+        );
+    }
+}
