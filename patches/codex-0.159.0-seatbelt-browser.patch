+#[test]
+fn chromium_rendezvous_only_for_protected_networked_workspace_processes() {
+    let workspace = TempDir::new().expect("temporary workspace");
+    let canonical = FileSystemSandboxPolicy::from_legacy_sandbox_policy_for_cwd(
+        &SandboxPolicy::WorkspaceWrite {
+            writable_roots: Vec::new(),
+            network_access: true,
+            exclude_tmpdir_env_var: true,
+            exclude_slash_tmp: true,
+        },
+        workspace.path(),
+    );
+    let uid = unsafe { libc::getuid() };
+    let manager_denies = ["bus", "systemd"].map(|suffix| {
+        FileSystemSandboxEntry::new(
+            absolute_path(&format!("/run/user/{uid}/{suffix}")).into(),
+            FileSystemAccessMode::Deny,
+        )
+    });
+    let mut protected = canonical.clone();
+    protected.entries.extend(manager_denies.clone());
+    let mut reordered = protected.clone();
+    reordered.entries.reverse();
+    let mut duplicated = protected.clone();
+    duplicated.entries.extend(manager_denies.clone());
+    let mut denied_glob = protected.clone();
+    denied_glob.entries.push(FileSystemSandboxEntry {
+        path: FileSystemPath::GlobPattern {
+            pattern: format!("{}/**/*.env", workspace.path().display()),
+        },
+        access: FileSystemAccessMode::Deny,
+        missing_path_behavior: None,
+    });
+    let git_common = workspace.path().join("repository/.git");
+    let git_worktree = git_common.join("worktrees/task");
+    let task_state = workspace.path().join("task-state");
+    for path in [&git_common, &git_worktree, &task_state] {
+        fs::create_dir_all(path).expect("create writable role root");
+    }
+    let mut worker = FileSystemSandboxPolicy::from_legacy_sandbox_policy_for_cwd(
+        &SandboxPolicy::WorkspaceWrite {
+            writable_roots: vec![git_common, git_worktree, task_state]
+                .into_iter()
+                .map(|path| AbsolutePathBuf::from_absolute_path(path).expect("absolute root"))
+                .collect(),
+            network_access: true,
+            exclude_tmpdir_env_var: false,
+            exclude_slash_tmp: false,
+        },
+        workspace.path(),
+    );
+    worker.entries.extend(manager_denies.clone());
+    let mut denied_read = protected.clone();
+    denied_read.entries.push(FileSystemSandboxEntry::new(
+        AbsolutePathBuf::from_absolute_path(workspace.path().join("private"))
+            .expect("absolute private path")
+            .into(),
+        FileSystemAccessMode::Deny,
+    ));
+    let mut read_only_child = protected.clone();
+    read_only_child.entries.push(FileSystemSandboxEntry::new(
+        AbsolutePathBuf::from_absolute_path(workspace.path().join("docs"))
+            .expect("absolute docs path")
+            .into(),
+        FileSystemAccessMode::Read,
+    ));
+    let minimal = FileSystemSandboxPolicy::restricted(vec![
+        FileSystemSandboxEntry::new(
+            FileSystemPath::Special {
+                value: FileSystemSpecialPath::Minimal,
+            },
+            FileSystemAccessMode::Read,
+        ),
+        FileSystemSandboxEntry::new(
+            AbsolutePathBuf::from_absolute_path(workspace.path())
+                .expect("absolute workspace")
+                .into(),
+            FileSystemAccessMode::Write,
+        ),
+    ]);
+    let mut coordinator = FileSystemSandboxPolicy::restricted(vec![
+        FileSystemSandboxEntry::new(
+            FileSystemPath::Special {
+                value: FileSystemSpecialPath::Root,
+            },
+            FileSystemAccessMode::Read,
+        ),
+        FileSystemSandboxEntry::new(
+            AbsolutePathBuf::from_absolute_path(workspace.path())
+                .expect("runtime path")
+                .into(),
+            FileSystemAccessMode::Write,
+        ),
+        FileSystemSandboxEntry::new(
+            AbsolutePathBuf::from_absolute_path(workspace.path().join("project"))
+                .expect("project path")
+                .into(),
+            FileSystemAccessMode::Read,
+        ),
+    ]);
+    coordinator.entries.extend(manager_denies.clone());
+    let captured_review = FileSystemSandboxPolicy::restricted(vec![
+        FileSystemSandboxEntry::new(
+            FileSystemPath::Special {
+                value: FileSystemSpecialPath::Root,
+            },
+            FileSystemAccessMode::Deny,
+        ),
+        FileSystemSandboxEntry::new(
+            FileSystemPath::Special {
+                value: FileSystemSpecialPath::Minimal,
+            },
+            FileSystemAccessMode::Read,
+        ),
+        FileSystemSandboxEntry::new(
+            AbsolutePathBuf::from_absolute_path(workspace.path())
+                .expect("review runtime path")
+                .into(),
+            FileSystemAccessMode::Read,
+        ),
+        FileSystemSandboxEntry::new(
+            AbsolutePathBuf::from_absolute_path(workspace.path().join("snapshot"))
+                .expect("snapshot path")
+                .into(),
+            FileSystemAccessMode::Read,
+        ),
+    ]);
+    let mut cases = vec![
+        (
+            "protected workspace",
+            protected.clone(),
+            NetworkSandboxPolicy::Enabled,
+            MacosSeatbeltProfile::Process,
+            true,
+        ),
+        (
+            "equivalent reordered custom",
+            reordered,
+            NetworkSandboxPolicy::Enabled,
+            MacosSeatbeltProfile::Process,
+            true,
+        ),
+        (
+            "equivalent duplicated denies",
+            duplicated,
+            NetworkSandboxPolicy::Enabled,
+            MacosSeatbeltProfile::Process,
+            true,
+        ),
+        (
+            "worker Git and task roots",
+            worker,
+            NetworkSandboxPolicy::Enabled,
+            MacosSeatbeltProfile::Process,
+            true,
+        ),
+        (
+            "plain workspace",
+            canonical.clone(),
+            NetworkSandboxPolicy::Enabled,
+            MacosSeatbeltProfile::Process,
+            false,
+        ),
+        (
+            "network-disabled workspace",
+            protected.clone(),
+            NetworkSandboxPolicy::Restricted,
+            MacosSeatbeltProfile::Process,
+            false,
+        ),
+        (
+            "filesystem helper",
+            protected.clone(),
+            NetworkSandboxPolicy::Enabled,
+            MacosSeatbeltProfile::FileSystemHelper,
+            false,
+        ),
+        (
+            "coordinator role",
+            coordinator.clone(),
+            NetworkSandboxPolicy::Restricted,
+            MacosSeatbeltProfile::Process,
+            false,
+        ),
+        (
+            "coordinator filesystem with network",
+            coordinator,
+            NetworkSandboxPolicy::Enabled,
+            MacosSeatbeltProfile::Process,
+            false,
+        ),
+        (
+            "captured reviewer role",
+            captured_review.clone(),
+            NetworkSandboxPolicy::Restricted,
+            MacosSeatbeltProfile::Process,
+            false,
+        ),
+        (
+            "captured reviewer with network",
+            captured_review,
+            NetworkSandboxPolicy::Enabled,
+            MacosSeatbeltProfile::Process,
+            false,
+        ),
+        (
+            "read-only with network",
+            FileSystemSandboxPolicy::read_only(),
+            NetworkSandboxPolicy::Enabled,
+            MacosSeatbeltProfile::Process,
+            false,
+        ),
+        (
+            "read-only without network",
+            FileSystemSandboxPolicy::read_only(),
+            NetworkSandboxPolicy::Restricted,
+            MacosSeatbeltProfile::Process,
+            false,
+        ),
+        (
+            "unrestricted",
+            FileSystemSandboxPolicy::unrestricted(),
+            NetworkSandboxPolicy::Enabled,
+            MacosSeatbeltProfile::Process,
+            false,
+        ),
+        (
+            "external sandbox",
+            FileSystemSandboxPolicy::external_sandbox(),
+            NetworkSandboxPolicy::Enabled,
+            MacosSeatbeltProfile::Process,
+            false,
+        ),
+        (
+            "custom denied read",
+            denied_read,
+            NetworkSandboxPolicy::Enabled,
+            MacosSeatbeltProfile::Process,
+            false,
+        ),
+        (
+            "custom denied glob",
+            denied_glob,
+            NetworkSandboxPolicy::Enabled,
+            MacosSeatbeltProfile::Process,
+            false,
+        ),
+        (
+            "custom read-only child",
+            read_only_child,
+            NetworkSandboxPolicy::Enabled,
+            MacosSeatbeltProfile::Process,
+            false,
+        ),
+        (
+            "restricted minimal reviewer",
+            minimal,
+            NetworkSandboxPolicy::Enabled,
+            MacosSeatbeltProfile::Process,
+            false,
+        ),
+    ];
+    for suffix in ["bus", "systemd"] {
+        let mut missing = canonical.clone();
+        missing.entries.push(FileSystemSandboxEntry::new(
+            absolute_path(&format!("/run/user/{uid}/{suffix}")).into(),
+            FileSystemAccessMode::Deny,
+        ));
+        cases.push((
+            "missing one manager deny",
+            missing,
+            NetworkSandboxPolicy::Enabled,
+            MacosSeatbeltProfile::Process,
+            false,
+        ));
+    }
+    for path in [
+        format!("/run/user/{}", uid),
+        format!("/run/user/{uid}/bus/child"),
+        format!("/run/user/{uid}/systemd/child"),
+        format!("/run/user/{}/bus", u64::from(uid) + 1),
+        format!("/run/user/{}/systemd", u64::from(uid) + 1),
+    ] {
+        let mut substitution = protected.clone();
+        // Replace the deny of the corresponding service, rather than add a redundant child.
+        let index = if path.ends_with("systemd") || path.contains("systemd/") {
+            1
+        } else {
+            0
+        };
+        substitution
+            .entries
+            .retain(|entry| entry != &manager_denies[index]);
+        substitution.entries.push(FileSystemSandboxEntry::new(
+            absolute_path(&path).into(),
+            FileSystemAccessMode::Deny,
+        ));
+        cases.push((
+            "wrong UID or parent/child deny",
+            substitution,
+            NetworkSandboxPolicy::Enabled,
+            MacosSeatbeltProfile::Process,
+            false,
+        ));
+    }
+    for (name, filesystem, network, profile, permitted) in cases {
+        let original = filesystem.clone();
+        let args = create_seatbelt_command_args_with_profile(
+            CreateSeatbeltCommandArgsParams {
+                command: vec!["/usr/bin/true".to_string()],
+                file_system_sandbox_policy: &filesystem,
+                network_sandbox_policy: network,
+                sandbox_policy_cwd: workspace.path(),
+                enforce_managed_network: false,
+                managed_network: None,
+                environment_id: None,
+                network: None,
+                extra_allow_unix_sockets: &[],
+            },
+            profile,
+            /*allowed_symlinked_codex_home*/ None,
+        )
+        .expect("policy assembly");
+        assert_eq!(
+            filesystem, original,
+            "assembly must preserve original policy: {name}"
+        );
+        let text = seatbelt_policy_arg(&args);
+        assert_eq!(
+            text.contains("(allow mach-register mach-lookup"),
+            permitted,
+            "{name}"
+        );
+        if permitted {
+            for suffix in ["bus", "systemd"] {
+                let path = format!("/run/user/{uid}/{suffix}");
+                assert!(
+                    args.iter().any(|arg| arg.ends_with(&format!("={path}"))),
+                    "manager deny must remain in emitted params: {name} {path}"
+                );
+            }
+            assert!(text.contains("file-read"));
+            assert!(text.contains("require-not"));
+            let expression = text
+                .split("(global-name-regex #\"")
+                .nth(1)
+                .expect("rendezvous filter")
+                .split('"')
+                .next()
+                .expect("expression");
+            let matcher = regex_lite::Regex::new(expression).expect("name matcher");
+            for service in [
+                "org.chromium.Chromium.MachPortRendezvousServer.1",
+                "org.chromium.Chromium.MachPortRendezvousServer.1234",
+            ] {
+                assert!(matcher.is_match(service));
+            }
+            for service in [
+                "com.apple.WindowServer",
+                "org.chromium.Chromium.MachPortRendezvousServer.",
+                "org.chromium.Chromium.MachPortRendezvousServer.0",
+                "org.chromium.Chromium.MachPortRendezvousServer.01",
+                "org.chromium.Chromium.MachPortRendezvousServer.-1",
+                "org.chromium.Chromium.MachPortRendezvousServer.1234.extra",
+                "prefix.org.chromium.Chromium.MachPortRendezvousServer.1234",
+                "orgXchromiumXChromiumXMachPortRendezvousServerX1234",
+            ] {
+                assert!(
+                    !matcher.is_match(service),
+                    "unexpected service match: {service}"
+                );
+            }
+        }
+    }
+}
 
