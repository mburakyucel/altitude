+fn evaluator_detects_an_additional_write_grant() {
+    let tmp = TempDir::new().expect("tempdir");
+    let cwd = tmp.path().canonicalize().expect("canonical tempdir");
+    let child = cwd.join("child");
+    fs::create_dir(&child).expect("child root");
+    let policy = restricted_write_policy(&[&cwd, &child]);
+    let mut args = metadata_args(
+        &policy,
+        &cwd,
+        MacosSeatbeltProfile::Process,
+        /*trusted_home*/ None,
+    );
+    let target = child.join(".agents/settings");
+    assert!(!emitted_write_allows(&args, &target));
+    let index = args
+        .iter()
+        .position(|arg| arg == "-p")
+        .expect("policy argument")
+        + 1;
+    args[index].push_str("\n(allow file-write* (subpath (param \"WRITABLE_ROOT_0\")))\n");
+    assert!(emitted_write_allows(&args, &target));
