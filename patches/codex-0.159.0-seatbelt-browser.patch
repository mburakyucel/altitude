+fn contained_metadata_is_denied_by_every_write_alternative() {
+    // #625: fixed expectations for named worker common/worktree Git roots,
+    // independently of the public matcher used for the parity assertion.
+    for existing in ["missing", "file", "directory"] {
+        for reverse in [false, true] {
+            let tmp = TempDir::new().expect("tempdir");
+            let cwd = tmp.path().canonicalize().expect("canonical tempdir");
+            let common = cwd.join("repository/.git");
+            let middle = common.join("worktrees");
+            let child = middle.join("task");
+            let state = cwd.join("task-state");
+            let workspace = cwd.join("repository/.claude/worktrees/task");
+            for root in [&child, &state, &workspace] {
+                fs::create_dir_all(root).expect("writable fixture root");
+            }
+            fs::write(
+                workspace.join(".git"),
+                format!("gitdir: {}\n", child.display()),
+            )
+            .expect("worktree Git pointer");
+            for name in PROTECTED_METADATA_PATH_NAMES {
+                let metadata = child.join(name);
+                match existing {
+                    "missing" => {}
+                    "file" => fs::write(metadata, "fictional").expect("metadata file"),
+                    "directory" => fs::create_dir(metadata).expect("metadata directory"),
+                    _ => unreachable!(),
+                }
+            }
+            let mut roots = vec![
+                workspace.as_path(),
+                common.as_path(),
+                middle.as_path(),
+                child.as_path(),
+                state.as_path(),
+            ];
+            if reverse {
+                roots.reverse();
+            }
+            roots.push(child.as_path()); // duplicate entry does not remove protection
+            let policy = restricted_write_policy(&roots);
+            for profile in [
+                MacosSeatbeltProfile::Process,
+                MacosSeatbeltProfile::FileSystemHelper,
+            ] {
+                let args = metadata_args(&policy, &cwd, profile, /*trusted_home*/ None);
+                for name in PROTECTED_METADATA_PATH_NAMES {
+                    for target in [child.join(name), child.join(name).join("settings")] {
+                        assert!(!policy.can_write_local_path_with_cwd(&target, &cwd));
+                        assert!(
+                            !emitted_write_allows(&args, &target),
+                            "{existing}: {target:?}"
+                        );
+                    }
+                }
+                for target in [
+                    common.join("config"),
+                    workspace.join("ordinary"),
+                    child.join("index"),
+                    state.join("progress"),
+                ] {
+                    assert!(policy.can_write_local_path_with_cwd(&target, &cwd));
+                    assert!(
+                        emitted_write_allows(&args, &target),
+                        "ordinary write {target:?}"
+                    );
+                }
+                assert!(
+                    args.iter()
+                        .any(|arg| arg.starts_with("-DPROTECTED_ANCESTOR_")
+                            && arg.ends_with(&format!("={}", middle.display())))
+                );
+            }
+        }
+    }
+}
