+#[test]
+fn non_overlapping_profiles_keep_original_write_bytes_and_parameters() {
+    let tmp = TempDir::new().expect("tempdir");
+    let cwd = tmp.path().canonicalize().expect("canonical tempdir");
+    let one = cwd.join("one");
+    let two = cwd.join("two");
+    for root in [&one, &two] {
+        fs::create_dir(root).expect("disjoint root");
+    }
+    for paths in [
+        vec![],
+        vec![one.as_path()],
+        vec![one.as_path(), two.as_path()],
+    ] {
+        let policy = restricted_write_policy(&paths);
+        for profile in [
+            MacosSeatbeltProfile::Process,
+            MacosSeatbeltProfile::FileSystemHelper,
+        ] {
+            let args = metadata_args(&policy, &cwd, profile, /*trusted_home*/ None);
+            // The original caller's mapping, without contained-root additions.
+            let roots = policy.get_writable_roots_with_cwd_preserving_mutable_paths(&cwd);
+            let (original, definitions) = super::super::build_seatbelt_access_policy(
+                super::super::SeatbeltAccessKind::Write,
+                roots
+                    .into_iter()
+                    .map(|root| super::super::SeatbeltAccessRoot {
+                        protected_metadata_names:
+                            super::super::protected_metadata_names_for_writable_root(
+                                &policy, &root, &cwd,
+                            ),
+                        root: root.root,
+                        excluded_subpaths: root.read_only_subpaths,
+                    })
+                    .collect(),
+                /*allowed_symlinked_codex_home*/ None,
+            )
+            .expect("original non-overlap emission");
+            if original.is_empty() {
+                assert!(!seatbelt_policy_arg(&args).contains("(allow file-write*\n"));
+            } else {
+                assert!(seatbelt_policy_arg(&args).contains(&original));
+            }
+            let actual: Vec<_> = args
+                .iter()
+                .filter(|arg| arg.starts_with("-DWRITABLE_ROOT_"))
+                .cloned()
+                .collect();
+            let expected: Vec<_> = definitions
+                .into_iter()
+                .map(|(name, path)| format!("-D{name}={}", path.display()))
+                .collect();
+            assert_eq!(actual, expected);
+        }
+    }
+}
