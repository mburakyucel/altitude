{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["landed", "review"],
  "properties": {
    "landed": {
      "type": "object",
      "description": "an object with `prs`, `main_runs` and `deploy`: {\"prs\": [], \"main_runs\": [], \"deploy\": \"not-applicable\"} when nothing landed",
      "additionalProperties": false,
      "required": ["prs", "main_runs", "deploy"],
      "properties": {
        "prs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["number", "title", "merged", "merge_sha"],
            "properties": {
              "number": {"type": "integer", "description": "the pull request's number"},
              "title": {"type": ["string", "null"], "description": "the pull request's title"},
              "merged": {"type": "boolean", "description": "whether GitHub merged the pull request"},
              "merge_sha": {"type": ["string", "null"],
                            "description": "GitHub merge commit, in full or an unambiguous prefix of at least seven characters"}
            }
          }
        },
        "main_runs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "conclusion"],
            "properties": {
              "id": {"type": "string", "description": "the GitHub Actions run id on main, as text"},
              "conclusion": {"type": "string", "description": "the run's conclusion, such as success"}
            }
          }
        },
        "deploy": {"type": "string", "description": "healthy | not-applicable | failed: <why>"}
      }
    },
    "review": {
      "type": "array",
      "description": "a list of findings, each with `summary`, `disposition` and `reason`: [] when there were none",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["summary", "disposition", "reason"],
        "properties": {
          "summary": {"type": ["string", "null"], "description": "the finding in a sentence"},
          "severity": {"type": ["string", "null"]},
          "pr": {"type": ["integer", "null"], "description": "the delivered PR whose review raised the finding, in a task that ships several"},
          "disposition": {"type": "string", "enum": ["fixed", "dismissed", "open"]},
          "reason": {"type": ["string", "null"], "description": "why it was fixed or dismissed, or what tracks it while open"}
        }
      }
    },
    "blocked": {"type": ["string", "null"], "description": "the exact block; left out when nothing is blocked"},
    "decisions": {"type": "array", "items": {"type": "object"}},
    "fyi": {"type": "array", "items": {"type": "string"}},
    "follow_ups": {"type": "array", "items": {"type": "string"}},
    "deviations": {"type": "array", "items": {"type": "object"}},
    "spend": {"type": "object"}
  }
}
