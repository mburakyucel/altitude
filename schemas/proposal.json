{
 "type": "object",
 "additionalProperties": false,
 "required": [
  "summary",
  "approach",
  "alternatives",
  "class",
  "estimate",
  "envelope",
  "decision_needed",
  "question",
  "options",
  "always_list_hits",
  "files",
  "verification",
  "risks",
  "citations"
 ],
 "properties": {
  "summary": {
   "type": "string",
   "description": "Two sentences: what and why."
  },
  "approach": {
   "type": "string",
   "description": "The plan in ≤ 12 lines, concrete."
  },
  "alternatives": {
   "type": [
    "array",
    "null"
   ],
   "items": {
    "type": "object",
    "required": [
     "option",
     "why_not"
    ],
    "properties": {
     "option": {
      "type": "string"
     },
     "why_not": {
      "type": "string"
     }
    },
    "additionalProperties": false
   }
  },
  "class": {
   "type": "string",
   "enum": [
    "S",
    "M",
    "L"
   ]
  },
  "estimate": {
   "type": "object",
   "required": [
    "turns",
    "subagent_launches",
    "l1_count",
    "model_tiers"
   ],
   "properties": {
    "turns": {
     "type": "integer"
    },
    "subagent_launches": {
     "type": "integer"
    },
    "l1_count": {
     "type": [
      "integer",
      "null"
     ]
    },
    "model_tiers": {
     "type": [
      "string",
      "null"
     ]
    }
   },
   "additionalProperties": false
  },
  "envelope": {
   "type": "object",
   "properties": {
    "l1_in_flight": {
     "type": [
      "integer",
      "null"
     ]
    },
    "subagent_launches": {
     "type": [
      "integer",
      "null"
     ]
    },
    "max_turns": {
     "type": [
      "integer",
      "null"
     ]
    }
   },
   "additionalProperties": false,
   "required": [
    "l1_in_flight",
    "subagent_launches",
    "max_turns"
   ]
  },
  "decision_needed": {
   "type": "boolean"
  },
  "question": {
   "type": [
    "string",
    "null"
   ]
  },
  "options": {
   "type": [
    "array",
    "null"
   ],
   "items": {
    "type": "string"
   },
   "description": "Recommended first; 2–4 items."
  },
  "always_list_hits": {
   "type": "array",
   "items": {
    "type": "string",
    "enum": [
     "money",
     "infra",
     "iam",
     "migration",
     "deploy",
     "scope",
     "product",
     "rules"
    ]
   }
  },
  "files": {
   "type": "array",
   "description": "Every entry is one bare repo-relative path (a file or narrow directory); put any explanation in the proposal rationale, and brace groups and comma lists are not accepted. A path that will be created may use the trailing `(new)` annotation.",
   "items": {
    "type": "string"
   }
  },
  "verification": {
   "type": "string",
   "description": "How done will be checked: tests, run, deploy check."
  },
  "risks": {
   "type": [
    "array",
    "null"
   ],
   "items": {
    "type": "string"
   }
  },
  "citations": {
   "type": "array",
   "items": {
    "type": "string"
   },
   "description": "Controlling decisions / doc sections relied on."
  }
 }
}
