{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["message", "actions"],
  "properties": {
    "message": {"type": "string"},
    "actions": {
      "type": "array",
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "slug", "title", "text", "reason", "request", "digest", "answer", "source", "engine", "model", "paths", "hold_merge", "merge_hold", "incident", "labels"],
        "properties": {
          "type": {"type": "string", "enum": ["new_task", "task_done", "task_block", "task_fyi", "task_hold_merge", "github_issue", "incident_new", "incident_amend"]},
          "slug": {"type": ["string", "null"]},
          "title": {"type": ["string", "null"]},
          "text": {"type": ["string", "null"], "description": "Text for task_fyi or github_issue. For new_task, use request."},
          "reason": {"type": ["string", "null"]},
          "request": {"type": ["string", "null"], "description": "For new_task, the complete non-empty brief for its L2 owner."},
          "digest": {"type": ["string", "null"]},
          "answer": {"type": ["string", "null"]},
          "source": {"type": ["string", "null"], "enum": ["chat", "recovery", null]},
          "engine": {"type": ["string", "null"], "enum": ["codex", null]},
          "model": {"type": ["string", "null"]},
          "paths": {"type": "array", "items": {"type": "string"}},
          "hold_merge": {"type": ["string", "null"]},
          "merge_hold": {"type": ["boolean", "null"]},
          "incident": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "title", "task", "what", "evidence", "cause", "tags", "status"],
                "properties": {
                  "id": {"type": ["string", "null"]},
                  "title": {"type": ["string", "null"]},
                  "task": {"type": ["string", "null"]},
                  "what": {"type": ["string", "null"]},
                  "evidence": {"type": ["string", "null"]},
                  "cause": {"type": ["string", "null"]},
                  "tags": {"type": "array", "items": {"type": "string"}},
                  "status": {"type": ["string", "null"]}
                }
              },
              {"type": "null"}
            ]
          },
          "labels": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
