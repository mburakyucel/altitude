{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["message", "outcome"],
  "properties": {
    "message": {"type": "string", "pattern": "\\S"},
    "outcome": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "kind", "commit_message", "pr_title", "request_merge", "evidence", "observations"],
          "properties": {
            "version": {"const": 1},
            "kind": {"const": "publish"},
            "commit_message": {"type": "string", "pattern": "\\S"},
            "pr_title": {"type": ["string", "null"], "pattern": "\\S"},
            "request_merge": {"type": "boolean"},
            "evidence": {"$ref": "#/$defs/evidence"},
            "observations": {"$ref": "#/$defs/observations"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "kind", "digest", "evidence", "observations"],
          "properties": {
            "version": {"const": 1},
            "kind": {"const": "complete_no_code"},
            "digest": {"type": "string", "pattern": "\\S"},
            "evidence": {"$ref": "#/$defs/evidence"},
            "observations": {"$ref": "#/$defs/observations"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "kind", "reason_or_question", "resume_condition", "observations"],
          "properties": {
            "version": {"const": 1},
            "kind": {"const": "block"},
            "reason_or_question": {"type": "string", "pattern": "\\S"},
            "resume_condition": {"type": "string", "pattern": "\\S"},
            "observations": {"$ref": "#/$defs/observations"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "kind", "reason", "helper_requests", "observations"],
          "properties": {
            "version": {"const": 1},
            "kind": {"const": "continue"},
            "reason": {"type": "string", "pattern": "\\S"},
            "helper_requests": {
              "type": "array",
              "maxItems": 4,
              "items": {"$ref": "#/$defs/helper"}
            },
            "observations": {"$ref": "#/$defs/observations"}
          }
        }
      ]
    }
  },
  "$defs": {
    "evidence": {"type": "array", "items": {"type": "string", "pattern": "\\S"}},
    "scope": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "kind", "paths"],
          "properties": {
            "version": {"const": 1},
            "kind": {"const": "paths"},
            "paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {
              "type": "string",
              "pattern": "^(?=.*\\S)(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)(?!.*\\\\)(?!.*\\u0000)[^/]+(?:/[^/]+)*$"
            }}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "kind"],
          "properties": {"version": {"const": 1}, "kind": {"const": "policy_derived"}}
        }
      ]
    },
    "helper": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "brief", "provider", "model", "scope"],
      "properties": {
        "role": {"type": "string", "enum": ["implementer", "reviewer"]},
        "brief": {"type": "string", "pattern": "\\S"},
        "provider": {"type": ["string", "null"], "enum": ["codex", null]},
        "model": {"type": ["string", "null"], "pattern": "\\S"},
        "scope": {"$ref": "#/$defs/scope"}
      }
    },
    "observations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["findings", "decisions", "fyis", "follow_up_proposals", "deviations", "usage", "spend", "merge_hold"],
      "properties": {
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["summary", "severity", "disposition", "reason"],
            "properties": {
              "summary": {"type": "string", "pattern": "\\S"},
              "severity": {"type": "string", "enum": ["blocker", "important", "optional"]},
              "disposition": {"type": "string", "enum": ["fixed", "dismissed", "open"]},
              "reason": {"type": ["string", "null"], "pattern": "\\S"}
            }
          }
        },
        "decisions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["question", "answer", "options"],
            "properties": {
              "question": {"type": "string", "pattern": "\\S"},
              "answer": {"type": ["string", "null"], "pattern": "\\S"},
              "options": {"type": "array", "items": {"type": "string", "pattern": "\\S"}}
            }
          }
        },
        "fyis": {"type": "array", "items": {"type": "string", "pattern": "\\S"}},
        "follow_up_proposals": {"type": "array", "items": {"type": "string", "pattern": "\\S"}},
        "deviations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["description", "reason"],
            "properties": {
              "description": {"type": "string", "pattern": "\\S"},
              "reason": {"type": ["string", "null"], "pattern": "\\S"}
            }
          }
        },
        "usage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["input_tokens", "cached_input_tokens", "output_tokens", "cost_usd"],
          "properties": {
            "input_tokens": {"type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991},
            "cached_input_tokens": {"type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991},
            "output_tokens": {"type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991},
            "cost_usd": {"type": ["number", "null"], "minimum": 0}
          }
        },
        "spend": {
          "type": "object",
          "additionalProperties": false,
          "required": ["turns", "subagent_launches", "retries", "reverts"],
          "properties": {
            "turns": {"type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991},
            "subagent_launches": {"type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991},
            "retries": {"type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991},
            "reverts": {"type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991}
          }
        },
        "merge_hold": {"type": ["string", "null"], "pattern": "\\S"}
      }
    }
  }
}
