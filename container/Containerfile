FROM docker.io/library/debian:trixie-slim@sha256:a99cfc517144bc59b1978475ec53b46ecabec7e43635402ee5b77cc54cd1b20a
ENV container=podman PYTHONDONTWRITEBYTECODE=1
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    systemd systemd-sysv dbus dbus-user-session python3 git openssl ca-certificates \
    bubblewrap util-linux procps curl openssh-client ripgrep nodejs npm \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 1000 --shell /bin/bash altitude \
    && mkdir -p /var/lib/systemd/linger /etc/altitude /etc/systemd/system/user@1000.service.d \
    && touch /var/lib/systemd/linger/altitude
# The distribution's gh 2.46 lacks baseRefOid, which the landing contract requires.
# Pin upstream release bytes for both image architectures; never install an unchecked download.
RUN set -eu; arch="$(dpkg --print-architecture)"; \
    case "$arch" in \
      amd64) checksum=698c8d88cc19cc92bfe96bad58d10b2a5b274c52433d6dc57799c81f6139d5fc ;; \
      arm64) checksum=33ccd2ad7ce639c927e1cb209e36555b0e1fbb89f7a38239c0568040ec758612 ;; \
      *) echo 'Unsupported container architecture' >&2; exit 1 ;; \
    esac; \
    curl --proto '=https' --tlsv1.2 --fail --location --retry 3 --max-time 120 \
      "https://github.com/cli/cli/releases/download/v2.100.0/gh_2.100.0_linux_${arch}.deb" -o /tmp/gh.deb; \
    printf '%s  /tmp/gh.deb\n' "$checksum" | sha256sum --check -; \
    dpkg -i /tmp/gh.deb; rm /tmp/gh.deb
COPY app /opt/altitude
RUN cp /opt/altitude/container/altitude-volumes.service /etc/systemd/system/ \
    && mkdir -p /etc/systemd/user.conf.d \
    && cp /opt/altitude/container/user-defaults.conf /etc/systemd/user.conf.d/altitude.conf \
    && cp /opt/altitude/container/user-manager.conf /etc/systemd/system/user@1000.service.d/altitude.conf \
    && cp /opt/altitude/container/altitude.service /etc/systemd/user/ \
    && mkdir -p /etc/systemd/user/default.target.wants \
    && ln -s ../altitude.service /etc/systemd/user/default.target.wants/altitude.service \
    && ln -s /opt/altitude/bin/alt /usr/local/bin/alt \
    && printf 'altitude-container-v1\n' > /etc/altitude/container \
    && chmod -R go-w /opt/altitude /etc/altitude \
    && python3 /opt/altitude/container/strip_privileges.py
ENV ALTITUDE_HOST=0.0.0.0 ALTITUDE_PORT=8890 ALTITUDE_PUBLIC_HOST=localhost ALTITUDE_TLS=1
STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
