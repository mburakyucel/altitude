#!/usr/bin/env python3
"""Allow protected local branches to advance only to their fetched remote counterpart."""
from pathlib import Path
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from altitude.git_policy import main  # noqa: E402

raise SystemExit(main(["hook", "reference-transaction", *sys.argv[1:]]))
