#!/usr/bin/env python3
"""Block local merges into Altitude's protected base branch."""
from pathlib import Path
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from altitude.git_policy import main  # noqa: E402

raise SystemExit(main(["hook", "pre-merge-commit"]))
